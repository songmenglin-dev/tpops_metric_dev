+# 子进程里跑生成器：留档路径与输出路径指到临时目录，退出码才是真的退出码。
+_GENERATOR_WRAPPER = '''\
+import sys
+
+sys.path.insert(0, %(tools_dir)r)
+import build_response_rules as g
+
+g.MERGED_PROBE_PATH = %(probe_path)r
