+# -- enum_map -------------------------------------------------------------
+
+ENUM_RULE = {'type': 'enum_map', 'params': {
+    'mapping': {'1': '正常', '0': '异常'}, 'default': 'passthrough',
+}}
+
+
+def test_enum_map_translates_a_known_value():
