+++ b/tpops_kafka_collector/mapping/rules_cross.py
@@ -0,0 +1,85 @@
+"""跨轮/跨视图规则：``counter_delta`` / ``ratio_across``。
+
+- ``counter_delta``：累计计数 → 速率（差分基线在 ``deltas.py``）；
+- ``ratio_across``：分子分母来自**不同视图**（``activity_agg`` / ``stat_database``）。
+"""
+import logging
+from typing import Any, List, Mapping
+
+from .rules_context import (
+    MetricValue,
+    RuleContext,
+    RuleError,
+    grouped_items,
+    sum_values,
+    to_number,
+)
+
+LOGGER = logging.getLogger(__name__)
+
+
+def eval_counter_delta(metric_rule: Any, rule: Mapping[str, Any], ctx: RuleContext,
+                       deltas: Any) -> List[MetricValue]:
+    """累计计数 → 速率。
+
+    - 首轮无基线 → 只记基线，值为 None（不产出速率）；
+    - 累计值回退（实例重启）→ 丢弃本轮差分、记 ERROR（见 ``deltas.py``）；
+    - 时间差用**实际采集时刻之差**。
+    """
+    if deltas is None:
+        raise RuleError('counter_delta 需要差分基线存储')
+    params = rule.get('params') or {}
+    column = params.get('column')
+    policy = params.get('row_policy', 'per_row')
+    if policy == 'per_row':
+        results = []  # type: List[MetricValue]
+        for dims, row in grouped_items(metric_rule, params, ctx.rows):
+            value, _reason = deltas.rate(
+                metric_rule.metric_code, dims, to_number(row.get(column)), ctx.now_ms
+            )
+            results.append((dims, value, ctx.now_ms))
+        return results
+    total = sum_values([to_number(row.get(column)) for row in ctx.rows])
+    value, _reason = deltas.rate(metric_rule.metric_code, {}, total, ctx.now_ms)
+    return [({}, value, ctx.now_ms)]
+
+
+def eval_ratio_across(metric_rule: Any, rule: Mapping[str, Any], ctx: RuleContext,
+                      deltas: Any) -> List[MetricValue]:
+    """跨视图比率。
+
+    **分母取不到（为 0 或视图缺失）→ 不产出**（M-3）：比率在分母为 0 时没有定义，
+    编一个 ``0.0`` 出去等于把「取不到」说成「真的是 0」—— 与本项目
+    「不静默出 0」的口径相反（规格「缺值不产出假数据」）。
+
+    分母可用、分子为 0 → 产出 ``0.0``：那是真的「没有活跃会话」。
+    比率保留 2 位小数（投递规格：比率类按客户指标表的数据类型序列化）。
+    """
+    params = rule.get('params') or {}
+    denominator = side_value(params.get('denominator') or {}, ctx)
+    if not denominator:
+        LOGGER.warning(
+            'ratio_across 的分母不可用（%s），本轮不产出该指标的值',
+            (params.get('denominator') or {}).get('sql_key'),
+        )
+        return []
+    numerator = side_value(params.get('numerator') or {}, ctx)
+    return [({}, round(numerator / denominator, 2), ctx.now_ms)]
+
+
+def side_value(spec: Mapping[str, Any], ctx: RuleContext) -> float:
+    """比率的一侧：按 ``fn`` 汇总该视图的行。
+
+    ``fn`` 支持 ``sum``（默认）/ ``max`` / ``count``。
+    """
+    rows = ctx.rows_by_key.get(spec.get('sql_key')) or ()
+    column = spec.get('value_column')
+    fn = spec.get('fn', 'sum')
+    if fn == 'sum':
+        return float(sum_values([to_number(row.get(column)) for row in rows]))
+    if fn == 'max':
+        values = [to_number(row.get(column)) for row in rows]
+        return max(values) if values else 0.0
+    if fn == 'count':
+        return float(len(rows))
+    raise RuleError(f'未实现的 ratio fn：{fn}')
diff --git a/tpops_kafka_collector/mapping/rules_deltas.py b/tpops_kafka_collector/mapping/rules_deltas.py
new file mode 100644
index 0000000..dd86fcc
--- /dev/null
+++ b/tpops_kafka_collector/mapping/rules_deltas.py
@@ -0,0 +1,66 @@
+"""累计计数器的差分基线。
+
+铁律（开发方案 §3.4 / 规格「累计计数的跨轮差分」）：
+
+- **首轮无基线只记基线**，不产出值（不是 0，也不是假数据）；
+- 时间差用**实际采集时刻之差**，不是标称采集周期；
+- 累计值回退判定为**实例重启**：丢弃本轮差分（值为 None）、记 **ERROR**、重建基线。
+
+**基线键的形状是跨模块契约**：
+``{(metric_code, dimension_key): (counter_value, sampled_at_ms)}`` ——
+``tpops_kafka_collector/watermark.py`` 的水位文件按同一形状存取基线，
+改了这里就存不上（``WatermarkError``）。
+"""
+import logging
+from typing import Any, Mapping, Optional, Tuple
+
+from .rules_context import dimension_key
+
+LOGGER = logging.getLogger(__name__)
+
+
+class CounterDeltaStore:
+    """累计计数器的差分基线。"""
+
+    def __init__(self) -> None:
+        self._baselines = {}  # type: Dict[Tuple[str, str], Tuple[float, int]]
+
+    def rate(
+        self,
+        metric_code: str,
+        dimensions: Mapping[str, Any],
+        counter_value: float,
+        now_ms: int,
+    ) -> Tuple[Optional[float], str]:
+        """返回 ``(速率, 说明)``。速率为 None 时说明原因。"""
+        key = (metric_code, dimension_key(dimensions))
+        previous = self._baselines.get(key)
+        if previous is None:
+            self._baselines[key] = (counter_value, now_ms)
+            LOGGER.debug(
+                '首轮无基线，仅建立基线：metric=%s dims=%s value=%s',
+                metric_code, dimensions, counter_value,
+            )
+            return None, '首轮无基线，仅建立基线'
+        last_value, last_ms = previous
+        if counter_value < last_value:
+            self._baselines[key] = (counter_value, now_ms)
+            LOGGER.error(
+                '累计计数回退，判定实例重启，丢弃本轮差分并重建基线：'
+                'metric=%s dims=%s 上次=%s 本次=%s',
+                metric_code, dimensions, last_value, counter_value,
+            )
+            return None, '累计值回退，判定实例重启，丢弃本轮差分并重建基线'
+        elapsed = (now_ms - last_ms) / 1000.0
+        if elapsed <= 0:
+            LOGGER.warning(
+                '采集时刻未推进，丢弃本轮差分：metric=%s dims=%s now=%s last=%s',
+                metric_code, dimensions, now_ms, last_ms,
+            )
+            return None, '采集时刻未推进，丢弃本轮差分'
+        self._baselines[key] = (counter_value, now_ms)
+        return (counter_value - last_value) / elapsed, '按采集时刻差分'
+
+    def forget(self, metric_code: str, dimensions: Mapping[str, Any]) -> None:
+        """丢掉某个维度组合的基线（对象消失时用）。"""
+        self._baselines.pop((metric_code, dimension_key(dimensions)), None)
diff --git a/tpops_kafka_collector/mapping/rules_engine.py b/tpops_kafka_collector/mapping/rules_engine.py
new file mode 100644
index 0000000..067fa52
--- /dev/null
+++ b/tpops_kafka_collector/mapping/rules_engine.py
@@ -0,0 +1,53 @@
+"""规则分派：``value_rule.type`` → 执行函数。
+
+映射表在用的**全部 13 种**规则类型都在 ``HANDLERS`` 里；
+表里没有的类型不实现（规格「SHALL NOT 引入映射表未使用的规则类型」），
+表里有的类型漏了就是启动期发现不了的缺陷 —— 所以这张表与
+``data/mapping/metric_rules.json`` 是同一份契约的两面。
+"""
+from typing import Any, Callable, List, Mapping, Optional
+
+from .rules_collection import (
+    eval_collection_count,
+    eval_instance_field,
+    eval_text_prefix_count,
+    eval_top_n,
+)
+from .rules_context import MetricValue, RuleContext, RuleError
+from .rules_cross import eval_counter_delta, eval_ratio_across
+from .rules_row import eval_aggregate, eval_raw, eval_raw_filtered, eval_raw_rows
+from .rules_series import eval_enum_map, eval_gauge, eval_series_point
+
+Handler = Callable[[Any, Mapping[str, Any], RuleContext, Any], List[MetricValue]]
+
+HANDLERS = {
+    'raw': eval_raw,
+    'raw_filtered': eval_raw_filtered,
+    'aggregate': eval_aggregate,
+    'counter_delta': eval_counter_delta,
+    'ratio_across': eval_ratio_across,
+    'series_point': eval_series_point,
+    'enum_map': eval_enum_map,
+    'gauge': eval_gauge,
+    'top_n': eval_top_n,
+    'raw_rows': eval_raw_rows,
+    'collection_count': eval_collection_count,
+    'text_prefix_count': eval_text_prefix_count,
+    'instance_field': eval_instance_field,
+}
+
+RULE_TYPES = tuple(sorted(HANDLERS))
+
+
+def evaluate(
+    metric_rule: Any,
+    ctx: RuleContext,
+    deltas: Optional[Any] = None,
+) -> List[MetricValue]:
+    """执行一个指标的取值规则，返回若干 ``(维度, 值, 时间戳)``。"""
+    rule = metric_rule.value_rule or {}
+    rule_type = rule.get('type')
+    handler = HANDLERS.get(rule_type)
+    if handler is None:
+        raise RuleError(f'未知的取值规则类型：{rule_type}')
+    return handler(metric_rule, rule, ctx, deltas)
diff --git a/tpops_kafka_collector/mapping/rules_naming.py b/tpops_kafka_collector/mapping/rules_naming.py
new file mode 100644
index 0000000..6c2e12b
--- /dev/null
+++ b/tpops_kafka_collector/mapping/rules_naming.py
@@ -0,0 +1,63 @@
+"""占位符替换与资源名拼装。
+
+- 占位符 ``{#NAME}`` 出现在客户指标的 ``metricName`` / ``metricCode`` 里，
+  替换成维度实际值（ITSCADA 文档 §7 的做法）；
+- ``resourceName`` 只能表示**一个节点**，模板是 ``{host_ip}_{node_id}``，
+  取不到值时按回退模板逐个试。
+"""
+import re
+from typing import Any, Mapping
+
+from .rules_context import RuleError
+
+PLACEHOLDER_RE = re.compile(r'\{#(\w+)\}')
+RESOURCE_FIELD_RE = re.compile(r'\{(\w+)\}')
+
+
+def substitute_placeholders(template: str, dimensions: Mapping[str, Any]) -> str:
+    """把 ``{#DATNAME}`` 替换成维度实际值。
+
+    维度里没有这个占位符就抛 ``RuleError`` —— 拼不出客户要的指标名，
+    不能悄悄留个 ``{#DATNAME}`` 出去。
+    """
+
+    def _replace(match: 're.Match') -> str:
+        name = match.group(1)
+        if name not in dimensions:
+            raise RuleError(f'占位符 {{{name}}} 没有对应的维度值')
+        value = dimensions[name]
+        return '' if value is None else str(value)
+
+    return PLACEHOLDER_RE.sub(_replace, template or '')
+
+
+def build_resource_name(
+    template: str,
+    context: Mapping[str, Any],
+    fallback_template: Any = None,
+) -> str:
+    """按模板拼资源名。
+
+    模板里的占位符取不到值时（None 或空串），改用回退模板；
+    回退模板可以给一串，按顺序取第一个渲染出非空结果的；
+    没有回退模板时留空串占位。
+    """
+    missing = [False]
+
+    def _replace(match: 're.Match') -> str:
+        value = context.get(match.group(1))
+        if value is None or value == '':
+            missing[0] = True
+            return ''
+        return str(value)
+
+    rendered = RESOURCE_FIELD_RE.sub(_replace, template or '')
+    if missing[0] and fallback_template:
+        fallbacks = (fallback_template,) if isinstance(fallback_template, str) \
+            else tuple(fallback_template)
+        for candidate in fallbacks:
+            attempt = build_resource_name(candidate, context)
+            if attempt:
+                return attempt
+        return ''
+    return rendered
diff --git a/tpops_kafka_collector/mapping/rules_row.py b/tpops_kafka_collector/mapping/rules_row.py
new file mode 100644
index 0000000..f98fb98
--- /dev/null
+++ b/tpops_kafka_collector/mapping/rules_row.py
@@ -0,0 +1,118 @@
+"""行级规则：``raw`` / ``raw_filtered`` / ``aggregate`` / ``raw_rows``。
+
+取值口径（与 ``tools/expected_deriver.py`` 的独立推导一致）：
+
+- ``raw``：``row_policy`` 三态 —— ``sum``（所有行求和）/ ``per_row``（一行一条，
+  维度按 ``group_by`` 分组）/ ``first``（第一行）；
+- ``raw_filtered``：按 ``filter`` 过滤后取**首个匹配行**（R-M1）；
+- ``aggregate``：``filter`` 过滤 → ``group_by`` 分组 → ``fn: sum``；
+- ``raw_rows``：整行列表。
+"""
+from typing import Any, List, Mapping, Tuple
+
+from .rules_context import (
+    MetricValue,
+    RuleContext,
+    RuleError,
+    grouped_items,
+    matches_filter,
+    row_dimensions,
+    sum_values,
+    to_int,
+    to_number,
+)
+
+
+def eval_raw(metric_rule: Any, rule: Mapping[str, Any], ctx: RuleContext,
+             deltas: Any) -> List[MetricValue]:
+    """直接取列。
+
+    - ``sum``：该列在所有行上求和；
+    - ``per_row``：一行一条（维度按 ``group_by`` 分组，见 ``grouped_items``）；
+    - ``first``：第一行（没有行就不产出）。
+    """
+    params = rule.get('params') or {}
+    column = params.get('column')
+    policy = params.get('row_policy', 'first')
+    if policy == 'sum':
+        values = [to_number(row.get(column)) for row in ctx.rows]
+        return [({}, sum_values(values), ctx.now_ms)]
+    if policy == 'per_row':
+        return [
+            (dims, row.get(column), ctx.now_ms)
+            for dims, row in grouped_items(metric_rule, params, ctx.rows)
+        ]
+    if policy == 'first':
+        if not ctx.rows:
+            return []
+        return [({}, ctx.rows[0].get(column), ctx.now_ms)]
+    raise RuleError(f'未知的 row_policy：{policy}')
+
+
+def eval_raw_filtered(metric_rule: Any, rule: Mapping[str, Any], ctx: RuleContext,
+                       deltas: Any) -> List[MetricValue]:
+    """过滤后取**首个匹配行**的值。
+
+    **多命中的口径（R-M1）**：取**首个**匹配行。留档上每个 filter 恰命中 1 行，
+    「首行 vs 末行」不可区分，所以这条口径由合成样本守着
+    （``tests/unit/test_rules.py::test_raw_filtered_takes_the_first_matching_row``）。
+
+    一个匹配行都没有 → 不产出（不是 0）。
+    """
+    params = rule.get('params') or {}
+    column = params.get('column')
+    matched = [row for row in ctx.rows if matches_filter(row, params.get('filter') or {})]
+    if not matched:
+        return []
+    row = matched[0]
+    value = row.get(column)
+    if params.get('cast') == 'int':
+        value = to_int(value)
+    # 维度要带上：指标名里的占位符（如 {#PORT}）要靠它替换，
+    # 不填的话组装消息时 substitute_placeholders 会直接抛异常。
+    dims = row_dimensions(metric_rule, row)
+    return [(dims, value, ctx.now_ms)]
+
+
+def eval_aggregate(metric_rule: Any, rule: Mapping[str, Any], ctx: RuleContext,
+                   deltas: Any) -> List[MetricValue]:
+    """过滤 → 分组 → 求和。
+
+    ``group_by`` 为空 → 整体求和出一条；不为空 → 每个分组一条，
+    分组顺序按**首次出现**的顺序（与 SQL 的 ``GROUP BY`` 结果顺序一致）。
+    """
+    params = rule.get('params') or {}
+    fn = params.get('fn', 'sum')
+    if fn != 'sum':
+        raise RuleError(f'未实现的 aggregate fn：{fn}')
+    rows = [row for row in ctx.rows if matches_filter(row, params.get('filter') or {})]
+    group_by = tuple(params.get('group_by') or ())
+    value_column = params.get('value_column', 'cnt')
+    if not group_by:
+        total = sum_values([to_number(row.get(value_column)) for row in rows])
+        return [({}, total, ctx.now_ms)]
+    groups = _group_rows(rows, group_by)
+    results = []  # type: List[MetricValue]
+    for group_rows in groups:
+        dims = row_dimensions(metric_rule, group_rows[0])
+        total = sum_values([to_number(row.get(value_column)) for row in group_rows])
+        results.append((dims, total, ctx.now_ms))
+    return results
+
+
+def eval_raw_rows(metric_rule: Any, rule: Mapping[str, Any], ctx: RuleContext,
+                  deltas: Any) -> List[MetricValue]:
+    """整行列表（会话清单、锁视图、库级统计）。"""
+    return [({}, [dict(row) for row in ctx.rows], ctx.now_ms)]
+
+
+def _group_rows(
+    rows: List[Mapping[str, Any]],
+    group_by: Tuple[str, ...],
+) -> List[List[Mapping[str, Any]]]:
+    """按 ``group_by`` 分组，保持首次出现的分组顺序。"""
+    groups = {}  # type: Dict[Tuple[Any, ...], List[Mapping[str, Any]]]
+    for row in rows:
+        key = tuple(str(row.get(column)) for column in group_by)
+        groups.setdefault(key, []).append(row)
+    return list(groups.values())
diff --git a/tpops_kafka_collector/mapping/rules_series.py b/tpops_kafka_collector/mapping/rules_series.py
new file mode 100644
index 0000000..f12a97d
--- /dev/null
+++ b/tpops_kafka_collector/mapping/rules_series.py
@@ -0,0 +1,100 @@
+"""时序类规则：``series_point`` / ``enum_map`` / ``gauge``。
+
+A 类（监控指标接口）按**组件**给出多条 series —— 每个组件（CN / DN）一条，
+维度键是 ``COMPONENT_ID``。规则在这一层取「每个组件的一个点」。
+"""
+import logging
+from typing import Any, List, Mapping, Optional, Sequence, Tuple
+
+from .rules_context import MetricValue, RuleContext, RuleError, point_timestamp
+
+LOGGER = logging.getLogger(__name__)
+
+
+def eval_series_point(metric_rule: Any, rule: Mapping[str, Any], ctx: RuleContext,
+                      deltas: Any) -> List[MetricValue]:
+    """取时序上的一个点（每个组件一条）。
+
+    ``position`` 支持 ``last_non_null``（默认）/ ``last`` / ``first_non_null`` /
+    ``first``；值为 null 的点跳过 —— **不产出假数据**。
+    """
+    params = rule.get('params') or {}
+    position = params.get('position', 'last_non_null')
+    results = []  # type: List[MetricValue]
+    for key, values in ctx.series.items():
+        value, index = pick_point(values, position)
+        if value is None:
+            continue
+        results.append(({'COMPONENT_ID': key}, value, point_timestamp(ctx, index)))
+    return results
+
+
+def eval_enum_map(metric_rule: Any, rule: Mapping[str, Any], ctx: RuleContext,
+                  deltas: Any) -> List[MetricValue]:
+    """把时序点的值按枚举表翻译。
+
+    枚举未命中时按 ``default`` 处理：``passthrough``（默认）原样透传**并记一条
+    WARNING**（规格「枚举未命中」场景：原样透传 + 告警级日志）；其它取值给 None。
+    """
+    params = rule.get('params') or {}
+    mapping = params.get('mapping') or {}
+    default = params.get('default', 'passthrough')
+    results = []  # type: List[MetricValue]
+    for dims, value, timestamp in eval_series_point(metric_rule, rule, ctx, deltas):
+        key = enum_key(value)
+        if key in mapping:
+            results.append((dims, mapping[key], timestamp))
+        elif default == 'passthrough':
+            LOGGER.warning(
+                '枚举未命中，原样透传：指标 %s 的值 %r 不在枚举表里',
+                metric_rule.metric_code, value,
+            )
+            results.append((dims, value, timestamp))
+        else:
+            results.append((dims, None, timestamp))
+    return results
+
+
+def eval_gauge(metric_rule: Any, rule: Mapping[str, Any], ctx: RuleContext,
+               deltas: Any) -> List[MetricValue]:
+    """由「启动时刻」推算已运行时长（平台没有 uptime 指标）。"""
+    params = rule.get('params') or {}
+    unit = params.get('unit', '秒')
+    if unit not in ('秒', 's'):
+        raise RuleError(f'gauge 规则的时间单位不支持：{unit}')
+    results = []  # type: List[MetricValue]
+    now_seconds = ctx.now_ms / 1000.0
+    for key, values in ctx.series.items():
+        point, index = pick_point(values, 'last_non_null')
+        if point is None:
+            continue
+        elapsed = now_seconds - float(point)
+        results.append(({'COMPONENT_ID': key}, round(elapsed, 2), point_timestamp(ctx, index)))
+    return results
+
+
+def pick_point(
+    values: Sequence[Optional[float]],
+    position: str,
+) -> Tuple[Optional[float], Optional[int]]:
+    """取时序上的一个点，返回 ``(值, 下标)``。值为 null 的点跳过。"""
+    if position in ('last_non_null', 'first_non_null'):
+        indexes = range(len(values) - 1, -1, -1) if position == 'last_non_null' \
+            else range(0, len(values))
+        for index in indexes:
+            value = values[index]
+            if value is not None:
+                return value, index
+        return None, None
+    if position == 'last':
+        return (values[-1], len(values) - 1) if values else (None, None)
+    if position == 'first':
+        return (values[0], 0) if values else (None, None)
+    raise RuleError(f'未知的时序取值位置：{position}')
+
+
+def enum_key(value: Any) -> str:
+    """枚举表的键：数值按整数形态查（``1.0`` 与 ``1`` 是同一个键）。"""
+    if isinstance(value, float) and value.is_integer():
+        return str(int(value))
+    return str(value)
diff --git a/tpops_kafka_collector/mapping/rules_sorting.py b/tpops_kafka_collector/mapping/rules_sorting.py
new file mode 100644
index 0000000..032e5e0
--- /dev/null
+++ b/tpops_kafka_collector/mapping/rules_sorting.py
@@ -0,0 +1,112 @@
+"""PostgreSQL ``ORDER BY`` 口径的排序。
+
+**为什么不能拿数值去比**：``top_n`` 的排序列有两类 —— 数值列
+（``total_elapse_time``）与**时间戳文本**列（``pg_stat_activity.query_start``，
+形如 ``2026-11-18 16:27:07.557567+08``）。后者按数值转换会全部退化成 0，
+排序变成**空操作**（稳定排序 → 原顺序），「取 Top N」就变成了「取前 N 行」。
+
+排序口径（与 PostgreSQL 一致）：
+
+- 列里第一个非空值决定比较类型：数值 / 时间戳 / 文本；
+- 数值按数值比；时间戳按**时间**比；文本按**字典序**比；
+- **空值**：升序排在最后、降序排在最前（PostgreSQL 的 ``ORDER BY`` 默认）。
+
+**空串按「空值」处理**：实测里平台把 NULL 的 ``query_start`` 渲染成空串
+（``data/metric_response/`` 的逐指标样本是 ``''``，合并留档是 ``null`` ——
+同一批行）。把空串当普通文本值会让「按时间取 Top 10」把没有时刻的行排在最前，
+与 SQL 自己的 ``ORDER BY``（NULL 升序在后）正好相反。
+"""
+import datetime
+from typing import Any, Callable, List, Mapping, Optional, Sequence
+
+from .rules_context import to_number
+
+# GaussDB 实测的时间戳文本格式（``pg_stat_activity.query_start``）。
+TIMESTAMP_FORMATS = (
+    '%Y-%m-%d %H:%M:%S.%f%z',
+    '%Y-%m-%d %H:%M:%S%z',
+)
+
+# 最小时间（排序兜底）—— 带时区，才能和带时区的时间戳比较。
+_MIN_TIMESTAMP = datetime.datetime.min.replace(tzinfo=datetime.timezone.utc)
+
+
+def sort_rows(
+    rows: Sequence[Mapping[str, Any]],
+    sort_by: Optional[str],
+    order: str = 'desc',
+) -> List[Mapping[str, Any]]:
+    """按 ``sort_by`` 排序（空值位置按 PostgreSQL 的 ``ORDER BY`` 默认口径）。"""
+    if not sort_by:
+        return list(rows)
+    values = [row.get(sort_by) for row in rows]
+    key_of = _sort_key(values)
+    present = [(row, value) for row, value in zip(rows, values) if not is_missing(value)]
+    missing = [row for row, value in zip(rows, values) if is_missing(value)]
+    present.sort(key=lambda pair: key_of(pair[1]), reverse=(order == 'desc'))
+    ordered = [row for row, _value in present]
+    if order == 'desc':
+        return missing + ordered
+    return ordered + missing
+
+
+def is_missing(value: Any) -> bool:
+    """空值判定：``None`` 与**空串**都算空值。
+
+    平台把 NULL 的时间戳渲染成空串（逐指标样本是 ``''``、合并留档是 ``null``），
+    两者是同一批行 —— 排序时必须一起当空值处理。
+    """
+    if value is None:
+        return True
+    return isinstance(value, str) and not value.strip()
+
+
+def _sort_key(values: Sequence[Any]) -> Callable[[Any], Any]:
+    """按列里值的类型选一个可比较的键（数值 / 时间戳 / 字符串）。"""
+    kind = _value_kind(values)
+    if kind == 'number':
+        return to_number
+    if kind == 'timestamp':
+        return _timestamp_key
+    return lambda value: '' if value is None else str(value)
+
+
+def _value_kind(values: Sequence[Any]) -> str:
+    """列的比较类型 —— 由**第一个非空值**决定。"""
+    for value in values:
+        if is_missing(value):
+            continue
+        if isinstance(value, bool):
+            return 'text'
+        if isinstance(value, (int, float)):
+            return 'number'
+        text = str(value).strip()
+        try:
+            float(text)
+            return 'number'
+        except ValueError:
+            pass
+        return 'timestamp' if parse_timestamp(text) is not None else 'text'
+    return 'text'
+
+
+def _timestamp_key(value: Any) -> datetime.datetime:
+    """时间戳文本 → 时间（解析不了按最小时间算，不抛异常）。"""
+    parsed = parse_timestamp(str(value).strip())
+    return parsed if parsed is not None else _MIN_TIMESTAMP
+
+
+def parse_timestamp(text: str) -> Optional[datetime.datetime]:
+    """解析 GaussDB 的时间戳文本；解析不了给 None。
+
+    没有时区的按 UTC 处理（统一成 aware，避免 aware/naive 混比报错）。
+    """
+    for fmt in TIMESTAMP_FORMATS:
+        try:
+            parsed = datetime.datetime.strptime(text, fmt)
+        except ValueError:
+            continue
+        if parsed.tzinfo is None:
+            parsed = parsed.replace(tzinfo=datetime.timezone.utc)
+        return parsed
+    return None
