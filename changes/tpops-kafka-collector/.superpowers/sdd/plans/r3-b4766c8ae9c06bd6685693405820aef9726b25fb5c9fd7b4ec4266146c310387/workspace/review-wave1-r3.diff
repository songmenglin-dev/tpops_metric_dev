+
+
+def test_idempotence_is_never_enabled_even_if_client_supports_it():
+    """即便将来换成支持幂等的客户端，传下去的值也必须是 False。"""
+    config = build_producer_config(('kafka-1:9092',))
+
+    assert config['enable_idempotence'] is False
