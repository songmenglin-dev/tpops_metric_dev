++def test_package_per_view_path_replays_every_command_center_sample():
++    """包内的 per-view 解码路径逐条回放旧留档，行数必须与留档一致。
++
++    这是「复制映射层没改坏」的守卫：合并形态的改造只应新增一条路径，
++    既有路径的行为一个字都不能变。
++    """
++    payload = _load(RULES_PATH)
++    checked = 0
++    for rule in payload['rules']:
