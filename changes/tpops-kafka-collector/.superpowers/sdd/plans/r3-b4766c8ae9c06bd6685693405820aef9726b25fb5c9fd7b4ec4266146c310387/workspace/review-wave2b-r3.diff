+
+def test_node_identity_from_ip_component_series_key(mapping, config):
+    """series 键 ``ip-component_id``（DN）→ 同样换算成节点身份。"""
+    client = FakeClient(monitor_payload([
+        {
+            'name': 'datanode_switch_status',
+            'metric_name': 'DN主备状态',
