++    :raises ConfigError: 必填项缺失或取值非法。
++    :return: 不可变的 :class:`Config`。
++    """
++    source: Mapping[str, str] = os.environ if env is None else env
++
++    fields: Dict[str, Any] = {}
++    try:
++        for loader in (
++            _tpops_fields,
++            _kafka_fields,
++            _schedule_fields,
++            _command_fields,
++            _alarm_fields,
++            _sql_fields,
++            _retry_fields,
++            _runtime_fields,
++        ):
