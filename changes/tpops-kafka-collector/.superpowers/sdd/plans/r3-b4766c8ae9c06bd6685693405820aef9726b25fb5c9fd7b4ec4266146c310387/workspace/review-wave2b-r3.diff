+    assert '采集周期' in caplog.text
+
+
+# ---------------------------------------------------------------------------
+# 空分组告警
+# ---------------------------------------------------------------------------
+
+def test_empty_group_logs_warning(mapping, config, caplog):
+    """分组码写错 → 200 + 空 series 且不报错 → 必须记告警日志。"""
