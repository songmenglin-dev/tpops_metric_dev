+new file mode 100644
+index 0000000..f12a97d
+--- /dev/null
++++ b/tpops_kafka_collector/mapping/rules_series.py
+@@ -0,0 +1,100 @@
++"""时序类规则：``series_point`` / ``enum_map`` / ``gauge``。
++
++A 类（监控指标接口）按**组件**给出多条 series —— 每个组件（CN / DN）一条，
++维度键是 ``COMPONENT_ID``。规则在这一层取「每个组件的一个点」。
++"""
++import logging
++from typing import Any, List, Mapping, Optional, Sequence, Tuple
++
++from .rules_context import MetricValue, RuleContext, RuleError, point_timestamp
++
++LOGGER = logging.getLogger(__name__)
++
++
++def eval_series_point(metric_rule: Any, rule: Mapping[str, Any], ctx: RuleContext,
++                      deltas: Any) -> List[MetricValue]:
++    """取时序上的一个点（每个组件一条）。
++
++    ``position`` 支持 ``last_non_null``（默认）/ ``last`` / ``first_non_null`` /
++    ``first``；值为 null 的点跳过 —— **不产出假数据**。
++    """
++    params = rule.get('params') or {}
++    position = params.get('position', 'last_non_null')
++    results = []  # type: List[MetricValue]
++    for key, values in ctx.series.items():
++        value, index = pick_point(values, position)
++        if value is None:
++            continue
++        results.append(({'COMPONENT_ID': key}, value, point_timestamp(ctx, index)))
++    return results
++
++
++def eval_enum_map(metric_rule: Any, rule: Mapping[str, Any], ctx: RuleContext,
++                  deltas: Any) -> List[MetricValue]:
++    """把时序点的值按枚举表翻译。
++
++    枚举未命中时按 ``default`` 处理：``passthrough``（默认）原样透传**并记一条
++    WARNING**（规格「枚举未命中」场景：原样透传 + 告警级日志）；其它取值给 None。
++    """
++    params = rule.get('params') or {}
++    mapping = params.get('mapping') or {}
++    default = params.get('default', 'passthrough')
++    results = []  # type: List[MetricValue]
++    for dims, value, timestamp in eval_series_point(metric_rule, rule, ctx, deltas):
++        key = enum_key(value)
++        if key in mapping:
++            results.append((dims, mapping[key], timestamp))
++        elif default == 'passthrough':
++            LOGGER.warning(
++                '枚举未命中，原样透传：指标 %s 的值 %r 不在枚举表里',
++                metric_rule.metric_code, value,
++            )
++            results.append((dims, value, timestamp))
++        else:
++            results.append((dims, None, timestamp))
++    return results
++
++
++def eval_gauge(metric_rule: Any, rule: Mapping[str, Any], ctx: RuleContext,
++               deltas: Any) -> List[MetricValue]:
++    """由「启动时刻」推算已运行时长（平台没有 uptime 指标）。"""
++    params = rule.get('params') or {}
++    unit = params.get('unit', '秒')
++    if unit not in ('秒', 's'):
++        raise RuleError(f'gauge 规则的时间单位不支持：{unit}')
++    results = []  # type: List[MetricValue]
++    now_seconds = ctx.now_ms / 1000.0
++    for key, values in ctx.series.items():
++        point, index = pick_point(values, 'last_non_null')
++        if point is None:
++            continue
++        elapsed = now_seconds - float(point)
++        results.append(({'COMPONENT_ID': key}, round(elapsed, 2), point_timestamp(ctx, index)))
++    return results
++
++
++def pick_point(
++    values: Sequence[Optional[float]],
++    position: str,
++) -> Tuple[Optional[float], Optional[int]]:
++    """取时序上的一个点，返回 ``(值, 下标)``。值为 null 的点跳过。"""
++    if position in ('last_non_null', 'first_non_null'):
++        indexes = range(len(values) - 1, -1, -1) if position == 'last_non_null' \
++            else range(0, len(values))
++        for index in indexes:
++            value = values[index]
++            if value is not None:
++                return value, index
++        return None, None
++    if position == 'last':
++        return (values[-1], len(values) - 1) if values else (None, None)
++    if position == 'first':
++        return (values[0], 0) if values else (None, None)
++    raise RuleError(f'未知的时序取值位置：{position}')
++
++
++def enum_key(value: Any) -> str:
++    """枚举表的键：数值按整数形态查（``1.0`` 与 ``1`` 是同一个键）。"""
++    if isinstance(value, float) and value.is_integer():
++        return str(int(value))
++    return str(value)
+diff --git a/tpops_kafka_collector/mapping/rules_sorting.py b/tpops_kafka_collector/mapping/rules_sorting.py
+new file mode 100644
+index 0000000..032e5e0
+--- /dev/null
++++ b/tpops_kafka_collector/mapping/rules_sorting.py
+@@ -0,0 +1,112 @@
++"""PostgreSQL ``ORDER BY`` 口径的排序。
++
++**为什么不能拿数值去比**：``top_n`` 的排序列有两类 —— 数值列
++（``total_elapse_time``）与**时间戳文本**列（``pg_stat_activity.query_start``，
++形如 ``2026-11-18 16:27:07.557567+08``）。后者按数值转换会全部退化成 0，
++排序变成**空操作**（稳定排序 → 原顺序），「取 Top N」就变成了「取前 N 行」。
++
++排序口径（与 PostgreSQL 一致）：
++
++- 列里第一个非空值决定比较类型：数值 / 时间戳 / 文本；
++- 数值按数值比；时间戳按**时间**比；文本按**字典序**比；
++- **空值**：升序排在最后、降序排在最前（PostgreSQL 的 ``ORDER BY`` 默认）。
++
++**空串按「空值」处理**：实测里平台把 NULL 的 ``query_start`` 渲染成空串
++（``data/metric_response/`` 的逐指标样本是 ``''``，合并留档是 ``null`` ——
++同一批行）。把空串当普通文本值会让「按时间取 Top 10」把没有时刻的行排在最前，
++与 SQL 自己的 ``ORDER BY``（NULL 升序在后）正好相反。
++"""
++import datetime
++from typing import Any, Callable, List, Mapping, Optional, Sequence
++
++from .rules_context import to_number
++
++# GaussDB 实测的时间戳文本格式（``pg_stat_activity.query_start``）。
++TIMESTAMP_FORMATS = (
++    '%Y-%m-%d %H:%M:%S.%f%z',
++    '%Y-%m-%d %H:%M:%S%z',
++)
++
++# 最小时间（排序兜底）—— 带时区，才能和带时区的时间戳比较。
++_MIN_TIMESTAMP = datetime.datetime.min.replace(tzinfo=datetime.timezone.utc)
++
++
++def sort_rows(
++    rows: Sequence[Mapping[str, Any]],
++    sort_by: Optional[str],
++    order: str = 'desc',
++) -> List[Mapping[str, Any]]:
++    """按 ``sort_by`` 排序（空值位置按 PostgreSQL 的 ``ORDER BY`` 默认口径）。"""
++    if not sort_by:
++        return list(rows)
++    values = [row.get(sort_by) for row in rows]
++    key_of = _sort_key(values)
++    present = [(row, value) for row, value in zip(rows, values) if not is_missing(value)]
++    missing = [row for row, value in zip(rows, values) if is_missing(value)]
++    present.sort(key=lambda pair: key_of(pair[1]), reverse=(order == 'desc'))
++    ordered = [row for row, _value in present]
++    if order == 'desc':
++        return missing + ordered
++    return ordered + missing
++
++
++def is_missing(value: Any) -> bool:
++    """空值判定：``None`` 与**空串**都算空值。
++
++    平台把 NULL 的时间戳渲染成空串（逐指标样本是 ``''``、合并留档是 ``null``），
++    两者是同一批行 —— 排序时必须一起当空值处理。
++    """
++    if value is None:
++        return True
++    return isinstance(value, str) and not value.strip()
++
++
++def _sort_key(values: Sequence[Any]) -> Callable[[Any], Any]:
++    """按列里值的类型选一个可比较的键（数值 / 时间戳 / 字符串）。"""
++    kind = _value_kind(values)
++    if kind == 'number':
++        return to_number
++    if kind == 'timestamp':
++        return _timestamp_key
++    return lambda value: '' if value is None else str(value)
++
++
++def _value_kind(values: Sequence[Any]) -> str:
++    """列的比较类型 —— 由**第一个非空值**决定。"""
++    for value in values:
++        if is_missing(value):
++            continue
++        if isinstance(value, bool):
++            return 'text'
++        if isinstance(value, (int, float)):
++            return 'number'
++        text = str(value).strip()
++        try:
++            float(text)
++            return 'number'
++        except ValueError:
++            pass
++        return 'timestamp' if parse_timestamp(text) is not None else 'text'
++    return 'text'
++
++
++def _timestamp_key(value: Any) -> datetime.datetime:
++    """时间戳文本 → 时间（解析不了按最小时间算，不抛异常）。"""
++    parsed = parse_timestamp(str(value).strip())
++    return parsed if parsed is not None else _MIN_TIMESTAMP
++
++
++def parse_timestamp(text: str) -> Optional[datetime.datetime]:
++    """解析 GaussDB 的时间戳文本；解析不了给 None。
++
++    没有时区的按 UTC 处理（统一成 aware，避免 aware/naive 混比报错）。
++    """
++    for fmt in TIMESTAMP_FORMATS:
++        try:
++            parsed = datetime.datetime.strptime(text, fmt)
++        except ValueError:
++            continue
++        if parsed.tzinfo is None:
++            parsed = parsed.replace(tzinfo=datetime.timezone.utc)
++        return parsed
++    return None
+diff --git a/tpops_kafka_collector/models.py b/tpops_kafka_collector/models.py
