index 0000000..b67545e
--- /dev/null
+++ b/tpops_kafka_collector/tpops/command_center_nodes.py
@@ -0,0 +1,110 @@
+"""命令中心的 master 节点清单：只留 master + 按 ``node_id`` 去重 + 按实例缓存。
+
+与 :mod:`tpops_kafka_collector.tpops.command_center` 配套（任务 2.5）——
+单独成文件是为了守住「单文件 < 400 行」的红线。
+
+**三条实测踩过的坑在这里固化**：
+
+1. **命令只能在 master 节点执行** —— 命令级约束 ``limit_node_types=["master"]``。
+   平台清单里既有 master 也有 slave；只留 ``role == "master"``。
+2. **同一个 master 会以 CN / DN 各出现一次** —— 实测 12 条条目 / 6 条 master /
+   **3 个唯一 node_id**。下发前**必须按 ``node_id`` 去重**，
+   否则同一个节点会被下发两次。
+3. **节点清单按实例缓存 1 小时** —— 不每轮都拉平台。
+"""
+import logging
+from typing import Any, Callable, Dict, List, Mapping, Optional, Tuple  # noqa: F401  （Dict/List 仅用于 # type: 注释）
+
+from ..errors import ProtocolError
+from .client import GAUSSDB_V3, require_fields
+
+LOGGER = logging.getLogger(__name__)
+
+__all__ = ['EXECUTE_NODE_PATH', 'NODE_CACHE_TTL_SECONDS', 'MasterNodeRegistry']
+
+#: 取可执行节点清单（命令**只能**在 master 节点执行，下发前必须先拿）。
+EXECUTE_NODE_PATH = GAUSSDB_V3 + '/instances/{instance_id}/key-view-execute-node'
+
+#: 节点清单的缓存时长（秒）—— **按实例**缓存，不每轮都拉。
+NODE_CACHE_TTL_SECONDS = 3600.0
+
+#: master 节点在平台清单里的角色标记。
+MASTER_ROLE = 'master'
+
+
+class MasterNodeRegistry:
+    """master 节点清单的取数与缓存。
+
+    :param client: TPOPS HTTP 客户端（需有 ``get``）。
+    :param ttl: 缓存时长（秒）。
+    :param clock: 单调时钟（测试注入假实现）。
+    """
+
+    def __init__(
+        self,
+        client: Any,
+        ttl: float = NODE_CACHE_TTL_SECONDS,
+        clock: Callable[[], float] = None,
+    ) -> None:
+        self._client = client
+        self._ttl = ttl
+        self._clock = clock if clock is not None else _default_clock
+        # 实例 → (取回时刻, 去重后的 master 节点元组)
+        self._cache = {}  # type: Dict[str, Tuple[float, Tuple[Mapping[str, Any], ...]]]
+
+    def nodes(self, instance_id: str) -> Tuple[Mapping[str, Any], ...]:
+        """实例的 master 节点清单（按 ``node_id`` 去重，顺序稳定）。"""
+        cached = self._cached(instance_id)
+        if cached is not None:
+            return cached
+        path = EXECUTE_NODE_PATH.format(instance_id=instance_id)
+        body = self._client.get(path)
+        raw = require_fields(body, ('nodes',), path).get('nodes') or []
+        masters = _select_masters(raw)
+        if not masters:
+            raise ProtocolError(
+                f'实例 {instance_id} 的节点清单里没有可执行的 master 节点'
+            )
+        self._cache[instance_id] = (self._clock(), masters)
+        return masters
+
+    def node_ids(self, instance_id: str) -> Tuple[str, ...]:
+        """master 节点 ID 列表（已去重，顺序稳定）。"""
+        return tuple(str(node['node_id']) for node in self.nodes(instance_id))
+
+    def _cached(
+        self, instance_id: str
+    ) -> Optional[Tuple[Mapping[str, Any], ...]]:
+        """取缓存的节点清单；过期或没有返回 ``None``。"""
+        entry = self._cache.get(instance_id)
+        if entry is None:
+            return None
+        fetched_at, nodes = entry
+        if self._clock() - fetched_at >= self._ttl:
+            return None
+        return nodes
+
+
+def _select_masters(
+    raw: Any,
+) -> Tuple[Mapping[str, Any], ...]:
+    """从平台清单里挑出 master 并**按 ``node_id`` 去重**。"""
+    masters = []  # type: List[Mapping[str, Any]]
+    seen = set()  # type: set
+    for node in raw or ():
+        if not isinstance(node, Mapping):
+            continue
+        if node.get('role') != MASTER_ROLE:
+            continue
+        node_id = node.get('node_id')
+        if not node_id or node_id in seen:
+            continue
+        seen.add(node_id)
+        masters.append(dict(node))
+    return tuple(masters)
+
+
+def _default_clock() -> float:
+    import time
+
+    return time.monotonic()
diff --git a/tpops_kafka_collector/tpops/command_center_result.py b/tpops_kafka_collector/tpops/command_center_result.py
new file mode 100644
index 0000000..855fbfc
--- /dev/null
+++ b/tpops_kafka_collector/tpops/command_center_result.py
@@ -0,0 +1,105 @@
+"""命令中心的结果数据类型与 ``result`` 二次解析。
+
+与 :mod:`tpops_kafka_collector.tpops.command_center` 配套（任务 2.5）——
+单独成文件是为了守住「单文件 < 400 行」的红线。
+
+**核心坑**：平台任务明细里的 ``result`` 是 **JSON 字符串**，
+要**再 ``json.loads`` 一次**才是行列表。**不要假设它已经是对象。**
+"""
+import json
+from dataclasses import dataclass
+from typing import Any, List, Mapping, Optional, Tuple  # noqa: F401  （List 仅用于 # type: 注释）
+
+from ..errors import DecodeError, TransientError
+
+__all__ = [
+    'CommandTaskError',
+    'NodeTask',
+    'SqlOutcome',
+    'parse_result_rows',
+]
+
+
+class CommandTaskError(TransientError):
+    """节点任务执行失败 —— **可重试**（实测偶发失败，重试即成功）。
+
+    继承 :class:`TransientError` → ``errors.is_retryable`` 判为可重试，
+    调用方**不**另写一份按类名精确相等的判定。
+    """
+
+
+@dataclass(frozen=True)
+class NodeTask:
+    """单个 master 节点上的任务结果（不可变）。
+
+    :param node_id: 节点 ID（TPOPS 的 ``node_id``）。
+    :param task_id: 任务 ID。
+    :param status: 平台任务状态（``succeed`` / ``failed`` / …）。
+    :param rows: **二次解析**后的行列表。
+    :param error: 失败原因（成功时为 ``None``）。
+    """
+
+    node_id: str
+    task_id: str
+    status: str
+    rows: Tuple[Mapping[str, Any], ...] = ()
+    error: Optional[str] = None
+
+
+@dataclass(frozen=True)
+class SqlOutcome:
+    """一条 SQL 的执行结果（成功与失败都**显式**表达，不静默吞异常）。
+
+    :param sql_text: 下发的 SQL 文本。
+    :param ok: 是否成功。
+    :param tasks: 各节点的任务结果（成功时非空）。
+    :param error: 失败原因（成功时为 ``None``）。
+    :param attempts: 实际尝试次数（含首次）。
+    :param job_id: 平台任务作业 ID。
+    :param exception: 失败时的原始异常（``is_retryable`` 判它是否可重试）。
+    """
+
+    sql_text: str
+    ok: bool
+    tasks: Tuple[NodeTask, ...] = ()
+    error: Optional[str] = None
+    attempts: int = 0
+    job_id: Optional[str] = None
+    exception: Optional[BaseException] = None
+
+
+def parse_result_rows(result: Any) -> Tuple[Mapping[str, Any], ...]:
+    """把任务明细的 ``result`` **二次解析**成行列表。
+
+    - 空串 / ``None`` → 空行列表（不是失败）；
+    - 已经是列表 → 直接用（防御平台改格式）；
+    - 不是合法 JSON → 抛 :class:`DecodeError`（不可重试，要人工介入）。
+
+    合并形态（一条合并 SQL）解析后是**恰好一行**，该行的每个键是一个视图名，
+    值是该视图的 JSON 字符串 —— 视图级解析在映射层（``mapping.decode``），
+    本层只做二次解析。
+    """
+    if result is None:
+        return ()
+    if isinstance(result, (bytes, str)):
+        text = result.decode('utf-8') if isinstance(result, bytes) else result
+        if not text.strip():
+            return ()
+        try:
+            payload = json.loads(text)
+        except ValueError as exc:
+            raise DecodeError(f'命令中心 result 不是合法 JSON：{exc}')
+    else:
+        payload = result
+    if not isinstance(payload, list):
+        raise DecodeError(
+            f'命令中心 result 期望行列表，实际是 {type(payload).__name__}'
+        )
+    rows = []  # type: List[Mapping[str, Any]]
+    for item in payload:
+        if not isinstance(item, Mapping):
+            raise DecodeError(
+                f'命令中心 result 里有非对象的行：{type(item).__name__}'
+            )
+        rows.append(dict(item))
+    return tuple(rows)
diff --git a/tpops_kafka_collector/tpops/diagnostic.py b/tpops_kafka_collector/tpops/diagnostic.py
new file mode 100644
index 0000000..6a402c4
--- /dev/null
+++ b/tpops_kafka_collector/tpops/diagnostic.py
@@ -0,0 +1,252 @@
+"""C 类（诊断优化接口）的平台层。
+
+对应开发方案 §4.2.6、规格 ``specs/collection-channels/spec.md``
+「诊断优化通道」。
+
+**两个接口都在第二套命名空间 ``/rds/gaussdb/v3/`` 下** —— 少写一段
+``gaussdb`` 平台就返回 404（不是「接口没实现」），86 个客户指标全丢。
+本模块把路径前缀写死在常量里，采集器只管调用。
+
+实测（``data/metric_response/019_…`` / ``035_…`` 留档）：
+
+===================================  ==========================================
+接口                                 请求 / 响应
+===================================  ==========================================
+``POST …/slow-sql-list``             请求 ``{start_time, end_time, instance_id,
+                                     threshold, threshold_unit, node_ids}``；
+                                     响应 ``{slow_sql_infos: [...], total}``
+``POST …/top-sql-list``              请求 ``{instance_id, node_ids, start_time,
+                                     end_time}``；
+                                     响应 ``{top_sql_infos: [...], total}``
+===================================  ==========================================
+
+两个接口返回的都是**当前快照**，没有自己的时间戳 —— 客户字段 ``clock``
+取采集完成时刻（由采集器传给规则引擎的 ``now_ms`` 决定）。
+
+本模块**只懂 TPOPS**：不发消息、不认识客户字段、不做业务计算。
+"""
+
+import logging
+from typing import Any, Dict, Mapping, Optional, Sequence, Tuple
+
+from ..errors import MappingError, ProtocolError
+from .client import GAUSSDB_V3
+
+LOGGER = logging.getLogger(__name__)
+
+__all__ = [
+    'COLLECTION_PATHS',
+    'DEFAULT_SLOW_SQL_THRESHOLD_MS',
+    'SLOW_SQL_COLLECTION',
+    'SLOW_SQL_PATH',
+    'SLOW_SQL_THRESHOLD_UNIT',
+    'SLOW_SQL_WINDOW_MS',
+    'TOP_SQL_COLLECTION',
+    'TOP_SQL_PATH',
+    'TOP_SQL_WINDOW_MS',
+    'build_slow_sql_body',
+    'build_top_sql_body',
+    'fetch_diagnostic_collection',
+    'fetch_slow_sql',
+    'fetch_top_sql',
+    'parse_slow_sql_rows',
+    'parse_top_sql_rows',
+]
+
+#: 慢 SQL 清单接口（第二套命名空间 —— 少了 ``gaussdb`` 就是 404）。
+SLOW_SQL_PATH = GAUSSDB_V3 + '/instances/{instance_id}/slow-sql-list'
+#: Top SQL 清单接口（同上）。
+TOP_SQL_PATH = GAUSSDB_V3 + '/instances/{instance_id}/top-sql-list'
+
+#: 慢 SQL 清单在响应体里的集合名。
+SLOW_SQL_COLLECTION = 'slow_sql_infos'
+#: Top SQL 清单在响应体里的集合名。
+TOP_SQL_COLLECTION = 'top_sql_infos'
+
+#: 集合名 → 接口路径模板（采集器按映射表声明的集合名取数，不写死接口）。
+COLLECTION_PATHS = {
+    SLOW_SQL_COLLECTION: SLOW_SQL_PATH,
+    TOP_SQL_COLLECTION: TOP_SQL_PATH,
+}
+
+#: 慢 SQL 的判定阈值（毫秒）—— 实测留档用的是 1000ms。
+DEFAULT_SLOW_SQL_THRESHOLD_MS = 1000
+#: 阈值单位（与平台一致）。
+SLOW_SQL_THRESHOLD_UNIT = 'ms'
+
+#: 慢 SQL 清单的查询窗口（毫秒）—— 实测留档用的是 **1 天**。
+SLOW_SQL_WINDOW_MS = 24 * 60 * 60 * 1000
+#: Top SQL 清单的查询窗口（毫秒）—— 实测留档用的是 **7 天**。
+TOP_SQL_WINDOW_MS = 7 * 24 * 60 * 60 * 1000
+
+#: 集合名 → 查询窗口（毫秒）。
+COLLECTION_WINDOWS = {
+    SLOW_SQL_COLLECTION: SLOW_SQL_WINDOW_MS,
+    TOP_SQL_COLLECTION: TOP_SQL_WINDOW_MS,
+}
+
+
+def build_slow_sql_body(
+    instance_id: str,
+    node_ids: Sequence[str],
+    start_time: int,
+    end_time: int,
+    threshold_ms: int = DEFAULT_SLOW_SQL_THRESHOLD_MS,
+    threshold_unit: str = SLOW_SQL_THRESHOLD_UNIT,
+) -> Dict[str, Any]:
+    """构造慢 SQL 清单的请求体（字段与实测留档逐字一致）。"""
+    if not instance_id:
+        raise MappingError('慢 SQL 清单请求缺少实例 ID')
+    return {
+        'start_time': int(start_time),
+        'end_time': int(end_time),
+        'instance_id': instance_id,
+        'threshold': int(threshold_ms),
+        'threshold_unit': threshold_unit,
+        'node_ids': list(node_ids or ()),
+    }
+
+
+def build_top_sql_body(
+    instance_id: str,
+    node_ids: Sequence[str],
+    start_time: int,
+    end_time: int,
+) -> Dict[str, Any]:
+    """构造 Top SQL 清单的请求体（字段与实测留档逐字一致）。"""
+    if not instance_id:
+        raise MappingError('Top SQL 清单请求缺少实例 ID')
+    return {
+        'instance_id': instance_id,
+        'node_ids': list(node_ids or ()),
+        'start_time': int(start_time),
+        'end_time': int(end_time),
+    }
+
+
+def parse_slow_sql_rows(
+    body: Mapping[str, Any],
+    endpoint: str = 'slow-sql-list',
+) -> Tuple[Mapping[str, Any], ...]:
+    """从慢 SQL 清单响应里取出 ``slow_sql_infos`` 集合。
+
+    - 集合字段缺失 → **当作空集合**并记 WARNING（平台某次没给这个字段，
+      不该让整轮采集炸掉）；
+    - 集合字段类型不对 → 抛 :class:`ProtocolError`（结构与预期不符，
+      重试只会再拿一份一样的坏数据）。
+    """
+    return _parse_collection(body, SLOW_SQL_COLLECTION, endpoint)
+
+
+def parse_top_sql_rows(
+    body: Mapping[str, Any],
+    endpoint: str = 'top-sql-list',
+) -> Tuple[Mapping[str, Any], ...]:
+    """从 Top SQL 清单响应里取出 ``top_sql_infos`` 集合。"""
+    return _parse_collection(body, TOP_SQL_COLLECTION, endpoint)
+
+
+def fetch_slow_sql(
+    client: Any,
+    instance_id: str,
+    node_ids: Sequence[str],
+    start_time: int,
+    end_time: int,
+    threshold_ms: int = DEFAULT_SLOW_SQL_THRESHOLD_MS,
+) -> Tuple[Mapping[str, Any], ...]:
+    """拉慢 SQL 清单并解析成行列表。"""
+    path = SLOW_SQL_PATH.format(instance_id=instance_id)
+    body = client.post(path, build_slow_sql_body(
+        instance_id=instance_id,
+        node_ids=node_ids,
+        start_time=start_time,
+        end_time=end_time,
+        threshold_ms=threshold_ms,
+    ))
+    return parse_slow_sql_rows(body, path)
+
+
+def fetch_top_sql(
+    client: Any,
+    instance_id: str,
+    node_ids: Sequence[str],
+    start_time: int,
+    end_time: int,
+) -> Tuple[Mapping[str, Any], ...]:
+    """拉 Top SQL 清单并解析成行列表。"""
+    path = TOP_SQL_PATH.format(instance_id=instance_id)
+    body = client.post(path, build_top_sql_body(
+        instance_id=instance_id,
+        node_ids=node_ids,
+        start_time=start_time,
+        end_time=end_time,
+    ))
+    return parse_top_sql_rows(body, path)
+
+
+def fetch_diagnostic_collection(
+    client: Any,
+    collection: str,
+    instance_id: str,
+    node_ids: Sequence[str],
+    start_time: int,
+    end_time: int,
+) -> Tuple[Mapping[str, Any], ...]:
+    """按**集合名**取诊断优化的数据（采集器按映射表声明的集合名调用）。
+
+    :raises MappingError: 集合名不在诊断优化接口的集合清单里
+        （说明映射表声明了平台没有的集合 —— 不可重试，要人工改表）。
+    """
+    path = COLLECTION_PATHS.get(collection)
+    if path is None:
+        raise MappingError(
+            f'诊断优化接口没有这个集合：{collection}（已知集合：{sorted(COLLECTION_PATHS)}）'
+        )
+    if collection == SLOW_SQL_COLLECTION:
+        return fetch_slow_sql(client, instance_id, node_ids, start_time, end_time)
+    return fetch_top_sql(client, instance_id, node_ids, start_time, end_time)
+
+
+def collection_window_ms(collection: str) -> Optional[int]:
+    """集合的查询窗口（毫秒）；未知集合给 ``None``。"""
+    return COLLECTION_WINDOWS.get(collection)
+
+
+# -- 内部实现 ------------------------------------------------------------
+def _parse_collection(
+    body: Mapping[str, Any],
+    collection: str,
+    endpoint: str,
+) -> Tuple[Mapping[str, Any], ...]:
+    """取一个集合并校验它是行列表。"""
+    if not isinstance(body, Mapping):
+        raise ProtocolError(
+            f'TPOPS 响应结构异常（{endpoint}）：期望对象，实际 {type(body).__name__}'
+        )
+    if collection not in body:
+        LOGGER.warning(
+            '诊断优化接口返回体里没有集合 %s（%s）—— 本轮按空集合处理',
+            collection, endpoint,
+        )
+        return ()
+    rows = body.get(collection)
+    if rows is None:
+        LOGGER.warning(
+            '诊断优化接口的集合 %s 是 null（%s）—— 本轮按空集合处理',
+            collection, endpoint,
+        )
+        return ()
+    if not isinstance(rows, list):
+        raise ProtocolError(
+            f'TPOPS 响应结构异常（{endpoint}）：集合 {collection} 期望行列表，'
+            f'实际 {type(rows).__name__}'
+        )
+    result = []  # type: list
+    for row in rows:
+        if not isinstance(row, Mapping):
+            raise ProtocolError(
+                f'TPOPS 响应结构异常（{endpoint}）：集合 {collection} 里有非对象的行：'
+                f'{type(row).__name__}'
+            )
+        result.append(row)
+    return tuple(result)
