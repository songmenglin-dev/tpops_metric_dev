++    ``top_sql_infos`` / ``slow_sql_infos``），否则从当前视图的行取
++    （命令中心的 ``activity_running`` / ``activity_top10``）。
++
++    排序按 PostgreSQL 的 ``ORDER BY`` 口径（见 ``sorting.py``），
++    再截断到 ``limit``，最后按 ``columns`` 投影。
++    """
++    params = rule.get('params') or {}
++    collection = params.get('collection')
++    if collection:
++        rows = list(ctx.collections.get(collection, ()))
++    else:
++        rows = list(ctx.rows)
++    ordered = sort_rows(rows, params.get('sort_by'), params.get('order', 'desc'))
++    limit = params.get('limit', 10)
++    selected = ordered[:limit]
++    columns = params.get('columns')
++    if columns:
++        selected = [{key: row.get(key) for key in columns} for row in selected]
++    return [({}, selected, ctx.now_ms)]
++
++
++def eval_collection_count(metric_rule: Any, rule: Mapping[str, Any], ctx: RuleContext,
++                          deltas: Any) -> List[MetricValue]:
++    """集合条数（慢 SQL 条数等）。"""
++    collection = (rule.get('params') or {}).get('collection', '')
++    return [({}, len(ctx.collections.get(collection, ())), ctx.now_ms)]
++
++
++def eval_text_prefix_count(metric_rule: Any, rule: Mapping[str, Any], ctx: RuleContext,
++                           deltas: Any) -> List[MetricValue]:
++    """按文本前缀给集合分类计数（``sql_text`` 以 ``select`` / ``insert`` 开头…）。
++
++    前缀比较忽略大小写并去掉首尾空白。
++    """
++    params = rule.get('params') or {}
++    collection = ctx.collections.get(params.get('collection', ''), ())
++    field_name = params.get('field', 'sql_text')
++    prefixes = [str(prefix).lower() for prefix in (params.get('prefixes') or ())]
++    count = 0
++    for item in collection:
++        text = str(item.get(field_name) or '').strip().lower()
++        if any(text.startswith(prefix) for prefix in prefixes):
++            count += 1
++    return [({}, count, ctx.now_ms)]
++
++
++def eval_instance_field(metric_rule: Any, rule: Mapping[str, Any], ctx: RuleContext,
++                         deltas: Any) -> List[MetricValue]:
++    """实例元数据里的一个字段（``engine_version`` 等）。"""
++    field_name = (rule.get('params') or {}).get('field')
++    return [({}, ctx.instance.get(field_name), ctx.now_ms)]
+diff --git a/tpops_kafka_collector/mapping/rules_context.py b/tpops_kafka_collector/mapping/rules_context.py
+new file mode 100644
+index 0000000..e322876
+--- /dev/null
++++ b/tpops_kafka_collector/mapping/rules_context.py
+@@ -0,0 +1,172 @@
++"""规则引擎的公共件：上下文、异常、数值/过滤/维度工具。
++
++取值结果一律是三元组 ``(维度键值, 值, 数据时间戳)``：
++
++- 维度为空表示该指标没有维度；
++- 时间戳是客户字段 ``clock`` 的来源（A 类取与 value 同一下标的
++  ``timestamps[i]``，其余取采集完成时刻）。
++"""
++import logging
++from dataclasses import dataclass, field
++from typing import Any, Dict, List, Mapping, Optional, Sequence, Tuple
++
++LOGGER = logging.getLogger(__name__)
++
++# 取值结果：(维度键值, 值, 数据时间戳)
++MetricValue = Tuple[Dict[str, Any], Any, Optional[int]]
++
++
++class RuleError(Exception):
++    """规则无法执行（声明与数据/声明自身矛盾）。"""
++
++
++@dataclass(frozen=True)
++class RuleContext:
++    """一次取数的输入。
++
++    - ``rows``：该指标自己那个视图的行；
++    - ``rows_by_key``：全部视图的行（跨视图比率用）；
++    - ``series``：按组件展开的时序（A 类监控指标）；
++    - ``collections``：按集合名展开的行（诊断优化接口）；
++    - ``instance``：实例元数据（D 类实例接口）；
++    - ``now_ms``：采集完成时刻（毫秒）—— 差分用的就是这个时刻。
++    """
++
++    rows: Tuple[Mapping[str, Any], ...] = ()
++    rows_by_key: Mapping[str, Sequence[Mapping[str, Any]]] = field(default_factory=dict)
++    series: Mapping[str, Sequence[Optional[float]]] = field(default_factory=dict)
++    timestamps: Tuple[int, ...] = ()
++    collections: Mapping[str, Sequence[Mapping[str, Any]]] = field(default_factory=dict)
++    instance: Mapping[str, Any] = field(default_factory=dict)
++    now_ms: int = 0
++
++
++# -- 数值工具 -------------------------------------------------------------
++
++def to_number(value: Any) -> float:
++    """取不到数就当 0（**只在求和场景用** —— 单点取值不经过这里）。"""
++    if value is None:
++        return 0.0
++    if isinstance(value, bool):
++        return float(value)
++    if isinstance(value, (int, float)):
++        return float(value)
++    try:
++        return float(value)
++    except (TypeError, ValueError):
++        return 0.0
++
++
++def to_int(value: Any) -> Optional[int]:
++    """转整数；转不了给 None（**不给 0** —— 缺值不是 0）。"""
++    if value is None:
++        return None
++    try:
++        return int(float(value))
++    except (TypeError, ValueError):
++        return None
++
++
++def sum_values(values: Sequence[Any]) -> Any:
++    """求和；结果是整数就返回整数（与客户指标表的「整数」类型对齐）。"""
++    total = 0.0
++    for value in values:
++        total += to_number(value)
++    if total.is_integer():
++        return int(total)
++    return total
++
++
++# -- 过滤与维度 -----------------------------------------------------------
++
++def matches_filter(row: Mapping[str, Any], filters: Mapping[str, Any]) -> bool:
++    """``filter`` 匹配。
++
++    - ``{"列": 值}`` → 等值；
++    - ``{"列_contains": [词]}`` → **子串包含**（忽略大小写）。
++
++    ``state_contains`` 是子串而不是等值：GaussDB 的会话状态是自由文本
++    （``waiting on lock`` / ``WAITING ON LOCK`` …），等值匹配会一条都命中不了。
++    """
++    for key, expected in (filters or {}).items():
++        if key.endswith('_contains'):
++            actual = row.get(key[:-len('_contains')])
++            text = '' if actual is None else str(actual).lower()
++            keywords = expected if isinstance(expected, (list, tuple)) else [expected]
++            if not any(str(word).lower() in text for word in keywords):
++                return False
++        elif row.get(key) != expected:
++            return False
++    return True
++
++
++def row_dimensions(metric_rule: Any, row: Mapping[str, Any]) -> Dict[str, Any]:
++    """按 ``dimension_bindings``（占位符 → 列名）取这一行的维度值。"""
++    dims = {}
++    for placeholder, column in (metric_rule.dimension_bindings or {}).items():
++        dims[placeholder] = row.get(column)
++    return dims
++
++
++def dimension_key(dimensions: Mapping[str, Any]) -> str:
++    """维度键（差分基线的键的一部分）—— 维度按键排序，与插入顺序无关。"""
++    if not dimensions:
++        return ''
++    return '|'.join(f'{key}={dimensions[key]}' for key in sorted(dimensions))
++
++
++def grouped_items(
++    metric_rule: Any,
++    params: Mapping[str, Any],
++    rows: Sequence[Mapping[str, Any]],
++) -> List[Tuple[Dict[str, Any], Mapping[str, Any]]]:
++    """行级规则的 ``group_by`` 执行入口 → ``[(维度, 行), ...]``。
++
++    **``group_by`` 是行级规则（``raw`` / ``counter_delta`` 的 ``per_row``）的分组键
++    声明**：它必须与 ``dimension_bindings`` 指向的列一致 —— 不一致说明声明自相矛盾
++    （一边说按 ``relname`` 分组、一边把 ``schemaname`` 当维度），抛 ``RuleError``
++    而不是静默取其中一个。分组键的值就是维度值。
++
++    分组键重复（同名的两张表落在同一个键里）会记 WARNING：维度值不唯一，
++    两条消息在幂等层会撞键 —— 显式报出来，不静默。
++    """
++    group_by = tuple((params or {}).get('group_by') or ())
++    bindings = metric_rule.dimension_bindings or {}
++    if not group_by:
++        return [(row_dimensions(metric_rule, row), row) for row in rows]
++    missing = sorted(set(bindings.values()) - set(group_by))
++    if missing:
++        raise RuleError(
++            f'group_by {list(group_by)} 与维度绑定 {dict(bindings)} 不一致：分组键缺少列 {missing}'
++        )
++    groups = {}  # type: Dict[Tuple[Any, ...], List[Mapping[str, Any]]]
++    for row in rows:
++        key = tuple(row.get(column) for column in group_by)
++        groups.setdefault(key, []).append(row)
++    items = []  # type: List[Tuple[Dict[str, Any], Mapping[str, Any]]]
++    for key, group_rows in groups.items():
++        if len(group_rows) > 1:
++            LOGGER.warning(
++                '分组键重复：指标 %s 的 group_by=%s 命中 %d 行同名对象，维度值不唯一',
++                metric_rule.metric_code, list(group_by), len(group_rows),
++            )
++        for row in group_rows:
++            dims = dict(
++                (placeholder, key[group_by.index(column)])
++                for placeholder, column in bindings.items()
++            )
++            items.append((dims, row))
++    return items
++
++
++def point_timestamp(ctx: RuleContext, index: Optional[int]) -> int:
++    """数据时间戳：A 类取与 value 同一下标的 ``timestamps[i]``，其余取采集完成时刻。
++
++    实测里 timestamps 会出现 0（平台没给采集时刻），此时回退到采集时刻；
++    客户字段 clock 是 Long，这里统一转成整数。
++    """
++    if index is not None and 0 <= index < len(ctx.timestamps):
++        stamp = ctx.timestamps[index]
++        if stamp:
++            return int(stamp)
++    return ctx.now_ms
+diff --git a/tpops_kafka_collector/mapping/rules_cross.py b/tpops_kafka_collector/mapping/rules_cross.py
+new file mode 100644
+index 0000000..3d896b1
+--- /dev/null
++++ b/tpops_kafka_collector/mapping/rules_cross.py
+@@ -0,0 +1,85 @@
++"""跨轮/跨视图规则：``counter_delta`` / ``ratio_across``。
++
++- ``counter_delta``：累计计数 → 速率（差分基线在 ``deltas.py``）；
++- ``ratio_across``：分子分母来自**不同视图**（``activity_agg`` / ``stat_database``）。
++"""
++import logging
++from typing import Any, List, Mapping
++
++from .rules_context import (
++    MetricValue,
++    RuleContext,
++    RuleError,
++    grouped_items,
++    sum_values,
++    to_number,
++)
++
++LOGGER = logging.getLogger(__name__)
++
++
++def eval_counter_delta(metric_rule: Any, rule: Mapping[str, Any], ctx: RuleContext,
++                       deltas: Any) -> List[MetricValue]:
++    """累计计数 → 速率。
++
++    - 首轮无基线 → 只记基线，值为 None（不产出速率）；
++    - 累计值回退（实例重启）→ 丢弃本轮差分、记 ERROR（见 ``deltas.py``）；
++    - 时间差用**实际采集时刻之差**。
++    """
++    if deltas is None:
++        raise RuleError('counter_delta 需要差分基线存储')
++    params = rule.get('params') or {}
++    column = params.get('column')
++    policy = params.get('row_policy', 'per_row')
++    if policy == 'per_row':
++        results = []  # type: List[MetricValue]
++        for dims, row in grouped_items(metric_rule, params, ctx.rows):
++            value, _reason = deltas.rate(
++                metric_rule.metric_code, dims, to_number(row.get(column)), ctx.now_ms
++            )
++            results.append((dims, value, ctx.now_ms))
++        return results
++    total = sum_values([to_number(row.get(column)) for row in ctx.rows])
++    value, _reason = deltas.rate(metric_rule.metric_code, {}, total, ctx.now_ms)
++    return [({}, value, ctx.now_ms)]
++
++
++def eval_ratio_across(metric_rule: Any, rule: Mapping[str, Any], ctx: RuleContext,
++                      deltas: Any) -> List[MetricValue]:
++    """跨视图比率。
++
++    **分母取不到（为 0 或视图缺失）→ 不产出**（M-3）：比率在分母为 0 时没有定义，
++    编一个 ``0.0`` 出去等于把「取不到」说成「真的是 0」—— 与本项目
++    「不静默出 0」的口径相反（规格「缺值不产出假数据」）。
++
++    分母可用、分子为 0 → 产出 ``0.0``：那是真的「没有活跃会话」。
++    比率保留 2 位小数（投递规格：比率类按客户指标表的数据类型序列化）。
++    """
++    params = rule.get('params') or {}
++    denominator = side_value(params.get('denominator') or {}, ctx)
++    if not denominator:
++        LOGGER.warning(
++            'ratio_across 的分母不可用（%s），本轮不产出该指标的值',
++            (params.get('denominator') or {}).get('sql_key'),
++        )
++        return []
++    numerator = side_value(params.get('numerator') or {}, ctx)
++    return [({}, round(numerator / denominator, 2), ctx.now_ms)]
++
++
++def side_value(spec: Mapping[str, Any], ctx: RuleContext) -> float:
++    """比率的一侧：按 ``fn`` 汇总该视图的行。
++
++    ``fn`` 支持 ``sum``（默认）/ ``max`` / ``count``。
++    """
++    rows = ctx.rows_by_key.get(spec.get('sql_key')) or ()
++    column = spec.get('value_column')
++    fn = spec.get('fn', 'sum')
++    if fn == 'sum':
++        return float(sum_values([to_number(row.get(column)) for row in rows]))
++    if fn == 'max':
++        values = [to_number(row.get(column)) for row in rows]
++        return max(values) if values else 0.0
++    if fn == 'count':
++        return float(len(rows))
++    raise RuleError(f'未实现的 ratio fn：{fn}')
+diff --git a/tpops_kafka_collector/mapping/rules_deltas.py b/tpops_kafka_collector/mapping/rules_deltas.py
+new file mode 100644
+index 0000000..dd86fcc
+--- /dev/null
++++ b/tpops_kafka_collector/mapping/rules_deltas.py
+@@ -0,0 +1,66 @@
++"""累计计数器的差分基线。
++
++铁律（开发方案 §3.4 / 规格「累计计数的跨轮差分」）：
++
++- **首轮无基线只记基线**，不产出值（不是 0，也不是假数据）；
++- 时间差用**实际采集时刻之差**，不是标称采集周期；
++- 累计值回退判定为**实例重启**：丢弃本轮差分（值为 None）、记 **ERROR**、重建基线。
++
++**基线键的形状是跨模块契约**：
++``{(metric_code, dimension_key): (counter_value, sampled_at_ms)}`` ——
++``tpops_kafka_collector/watermark.py`` 的水位文件按同一形状存取基线，
++改了这里就存不上（``WatermarkError``）。
++"""
++import logging
++from typing import Any, Mapping, Optional, Tuple
++
++from .rules_context import dimension_key
++
++LOGGER = logging.getLogger(__name__)
++
++
++class CounterDeltaStore:
++    """累计计数器的差分基线。"""
++
++    def __init__(self) -> None:
++        self._baselines = {}  # type: Dict[Tuple[str, str], Tuple[float, int]]
++
++    def rate(
++        self,
++        metric_code: str,
++        dimensions: Mapping[str, Any],
++        counter_value: float,
++        now_ms: int,
++    ) -> Tuple[Optional[float], str]:
++        """返回 ``(速率, 说明)``。速率为 None 时说明原因。"""
++        key = (metric_code, dimension_key(dimensions))
++        previous = self._baselines.get(key)
++        if previous is None:
++            self._baselines[key] = (counter_value, now_ms)
++            LOGGER.debug(
++                '首轮无基线，仅建立基线：metric=%s dims=%s value=%s',
++                metric_code, dimensions, counter_value,
++            )
++            return None, '首轮无基线，仅建立基线'
++        last_value, last_ms = previous
++        if counter_value < last_value:
++            self._baselines[key] = (counter_value, now_ms)
++            LOGGER.error(
++                '累计计数回退，判定实例重启，丢弃本轮差分并重建基线：'
++                'metric=%s dims=%s 上次=%s 本次=%s',
++                metric_code, dimensions, last_value, counter_value,
++            )
++            return None, '累计值回退，判定实例重启，丢弃本轮差分并重建基线'
++        elapsed = (now_ms - last_ms) / 1000.0
++        if elapsed <= 0:
++            LOGGER.warning(
++                '采集时刻未推进，丢弃本轮差分：metric=%s dims=%s now=%s last=%s',
++                metric_code, dimensions, now_ms, last_ms,
++            )
++            return None, '采集时刻未推进，丢弃本轮差分'
++        self._baselines[key] = (counter_value, now_ms)
++        return (counter_value - last_value) / elapsed, '按采集时刻差分'
++
++    def forget(self, metric_code: str, dimensions: Mapping[str, Any]) -> None:
++        """丢掉某个维度组合的基线（对象消失时用）。"""
++        self._baselines.pop((metric_code, dimension_key(dimensions)), None)
