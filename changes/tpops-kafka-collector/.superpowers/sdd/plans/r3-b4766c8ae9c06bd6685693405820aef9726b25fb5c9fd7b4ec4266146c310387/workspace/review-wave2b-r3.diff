+-    if policy == 'sum':
+-        values = [_to_number(row.get(column)) for row in rows]
+-        return [({}, _sum(values), ctx.now_ms)]
+-    if not rows:
+-        return []
+-    return [({}, rows[0].get(column), ctx.now_ms)]
