+        return {
+            'job_id': 'job-%d' % len(order),
+            'node_tasks': [{'task_id': 'task-0', 'node_id': MASTER_NODE_IDS[0]}],
+        }
+
+    platform = FakePlatform(submit=submit)
+    client = _client(platform, concurrency=1)
+
+    client.execute_batch(INSTANCE, ['select 0', 'select 1'])
+
+    assert len(order) == 2
