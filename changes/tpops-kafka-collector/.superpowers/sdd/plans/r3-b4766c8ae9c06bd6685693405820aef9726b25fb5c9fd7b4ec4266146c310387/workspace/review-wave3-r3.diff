index 0000000..c2e89c2
--- /dev/null
+++ b/tpops_kafka_collector/executors.py
@@ -0,0 +1,281 @@
+"""五个通道的**执行器**（装配层）。
+
+执行器契约（任务 3.1 报告 §5.5）::
+
+    (InstanceTarget) -> TaskOutcome
+
+三条硬约束：
+
+1. **停机检查** —— 每个执行器入口先看 ``shutdown``；已置位就**直接返回空的
+   ``TaskOutcome``**，**不发起任何 HTTP 请求**。
+   调度器（3.1）只保证「不再发起新任务」，**不保证**「不再发起新的 HTTP
+   请求」—— 本轮已经排进线程池但还没开始跑的任务仍会启动 → 停机检查必须
+   落在执行器这一层（规格「优雅退出」）。
+2. **取数失败时 ``end_time_ms`` 给 ``None``** —— 给值会让水位冲过头 →
+   **丢数据**。宁可重复投递，也不丢数据。
+3. **告警消息进 ``outcome.alarms``**，不进 ``outcome.messages`` ——
+   投递层按 ``outcome.alarms`` 走告警 Topic。
+
+通道与周期：
+
+============  ==========================================  ==================
+通道          采集器                                      周期
+============  ==========================================  ==================
+monitor       ``collectors.monitor.MonitorCollector``      映射表实算
+command_center ``collectors.command_center.…``            映射表实算
+diagnostic    ``collectors.diagnostic.DiagnosticCollector`` 映射表实算（120 秒）
+instance      ``collectors.instance.InstanceCollector``     映射表实算
+alarm         ``collectors.alarm.collect_alarms``          30 秒
+============  ==========================================  ==================
+"""
+import logging
+import threading
+from typing import Any, Callable, Dict, Optional
+
+from .collectors.alarm import collect_alarms
+from .collectors.command_center import CommandCenterCollector
+from .collectors.diagnostic import DiagnosticCollector
+from .collectors.instance import InstanceCollector
+from .collectors.monitor import MonitorCollector
+from .mapping.masking import sanitize_sql_with_config
+from .schedule import (
+    CHANNEL_ALARM,
+    CHANNEL_COMMAND_CENTER,
+    CHANNEL_DIAGNOSTIC,
+    CHANNEL_INSTANCE,
+    CHANNEL_MONITOR,
+)
+from .scheduler_types import InstanceTarget, TaskOutcome, alarm_stream
+from .tpops.metrics import resolve_window_from_config, utc_now_ms
+
+LOGGER = logging.getLogger(__name__)
+
+__all__ = ['build_executors']
+
+#: 各通道的外部调用次数（``external_calls``）—— 目录 + 查询 / 一次下发的页数等。
+MONITOR_EXTERNAL_CALLS = 2
+DIAGNOSTIC_EXTERNAL_CALLS = 1
+INSTANCE_EXTERNAL_CALLS = 2
+ALARM_EXTERNAL_CALLS = 4
+
+
+def build_executors(
+    client: Any,
+    mapping: Any,
+    config: Any,
+    command_center: Any = None,
+    node_registry: Any = None,
+    deltas: Any = None,
+    watermark: Any = None,
+    shutdown: Optional[threading.Event] = None,
+    clock: Optional[Callable[[], int]] = None,
+) -> Dict[str, Callable[[InstanceTarget], TaskOutcome]]:
+    """装配五个通道的执行器（**每个都套一层停机检查**）。
+
+    :param deltas: 差分基线存储 —— **必须与 ``Scheduler(delta_store=…)``
+        是同一个对象**（否则基线不落盘 → 重启后速率永远算不出来）。
+    :param watermark: 水位存储（告警执行器要读告警水位游标）。
+    :param shutdown: 停机事件；置位后执行器**不再发起任何 HTTP 请求**。
+    """
+    stop = shutdown if shutdown is not None else threading.Event()
+    now = clock if clock is not None else utc_now_ms
+    executors = {
+        CHANNEL_MONITOR: _monitor_executor(client, mapping, config, now),
+        CHANNEL_COMMAND_CENTER: _command_center_executor(
+            client, mapping, command_center, deltas, now,
+        ),
+        CHANNEL_DIAGNOSTIC: _diagnostic_executor(client, mapping, config, now),
+        CHANNEL_INSTANCE: _instance_executor(
+            client, mapping, node_registry, now,
+        ),
+        CHANNEL_ALARM: _alarm_executor(
+            client, mapping, config, watermark, now,
+        ),
+    }
+    return dict(
+        (channel, _guard(executor, stop))
+        for channel, executor in executors.items()
+    )
+
+
+def _guard(
+    executor: Callable[[InstanceTarget], TaskOutcome],
+    stop: threading.Event,
+) -> Callable[[InstanceTarget], TaskOutcome]:
+    """套一层停机检查：已停机 → 空的 ``TaskOutcome``，**不发任何请求**。"""
+
+    def run(instance: InstanceTarget) -> TaskOutcome:
+        if stop.is_set():
+            LOGGER.info(
+                '已收到停机信号，跳过本组采集（不发任何 HTTP 请求）：实例 %s',
+                instance.instance_id,
+            )
+            return TaskOutcome()
+        return executor(instance)
+
+    return run
+
+
+# ---------------------------------------------------------------------------
+# A 类：监控指标
+# ---------------------------------------------------------------------------
+
+def _monitor_executor(
+    client: Any,
+    mapping: Any,
+    config: Any,
+    clock: Callable[[], int],
+) -> Callable[[InstanceTarget], TaskOutcome]:
+    """A 类：监控指标接口 → 指标消息。"""
+
+    def run(target: InstanceTarget) -> TaskOutcome:
+        now_ms = int(clock())
+        window = resolve_window_from_config(now_ms, config)
+        collector = MonitorCollector(
+            client, mapping, target.instance_id, target.instance_name,
+            target.nodes, config, clock=lambda: now_ms,
+        )
+        messages = collector.collect()
+        return TaskOutcome(
+            messages=messages,
+            # 取数成功（异常会向上抛 → 调度器记该组失败 → 不推进水位）。
+            end_time_ms=window.end_time,
+            external_calls=MONITOR_EXTERNAL_CALLS,
+            fetched=len(messages),
+        )
+
+    return run
+
+
+# ---------------------------------------------------------------------------
+# B 类：命令中心
+# ---------------------------------------------------------------------------
+
+def _command_center_executor(
+    client: Any,
+    mapping: Any,
+    command_center: Any,
+    deltas: Any,
+    clock: Callable[[], int],
+) -> Callable[[InstanceTarget], TaskOutcome]:
+    """B 类：命令中心合并 SQL → 指标消息。
+
+    **采集器必须跨轮复用** —— 差分基线住在它持有的存储里，
+    每轮新建一个采集器就等于每轮只有首轮（只建基线、不出速率）。
+    """
+
+    collector = CommandCenterCollector(
+        client, mapping, command_center, deltas=deltas, clock=clock,
+    )
+
+    def run(target: InstanceTarget) -> TaskOutcome:
+        result = collector.collect(target.instance_id, target.instance_name)
+        # 取数失败时采集器返回空的 ``messages`` 且 **pages == 0**
+        # （执行过至少一页才会 pages >= 1）—— 这时**不推进水位**。
+        failed = result.pages <= 0
+        if failed:
+            LOGGER.warning(
+                '命令中心本轮没有取到数据（实例 %s）—— 不推进水位，下轮重取',
+                target.instance_id,
+            )
+        return TaskOutcome(
+            messages=result.messages,
+            end_time_ms=None if failed else int(clock()),
+            external_calls=max(result.pages, 1),
+            fetched=len(result.messages),
+            windows=result.pages,
+        )
+
+    return run
+
+
+# ---------------------------------------------------------------------------
+# C 类：诊断优化
+# ---------------------------------------------------------------------------
+
+def _diagnostic_executor(
+    client: Any,
+    mapping: Any,
+    config: Any,
+    clock: Callable[[], int],
+) -> Callable[[InstanceTarget], TaskOutcome]:
+    """C 类：诊断优化接口 → 指标消息。"""
+
+    def sanitize(text: str) -> str:
+        return sanitize_sql_with_config(text, config)
+
+    collector = DiagnosticCollector(client, mapping, sanitize, clock=clock)
+
+    def run(target: InstanceTarget) -> TaskOutcome:
+        messages = collector.collect(
+            target.instance_id, target.nodes, target.instance_name,
+        )
+        return TaskOutcome(
+            messages=messages,
+            # 一条都没产出 → 取不到数据（没有落点或平台没给数）→ 不推进水位。
+            end_time_ms=int(clock()) if messages else None,
+            external_calls=DIAGNOSTIC_EXTERNAL_CALLS,
+            fetched=len(messages),
+        )
+
+    return run
+
+
+# ---------------------------------------------------------------------------
+# D 类：实例元数据
+# ---------------------------------------------------------------------------
+
+def _instance_executor(
+    client: Any,
+    mapping: Any,
+    node_registry: Any,
+    clock: Callable[[], int],
+) -> Callable[[InstanceTarget], TaskOutcome]:
+    """D 类：实例元数据接口 → 指标消息。"""
+
+    collector = InstanceCollector(client, mapping, node_registry, clock=clock)
+
+    def run(target: InstanceTarget) -> TaskOutcome:
+        result = collector.collect(target.instance_id)
+        return TaskOutcome(
+            messages=result.messages,
+            # 一条都没产出 → 目标实例取不到或值取不到 → 不推进水位。
+            end_time_ms=int(clock()) if result.messages else None,
+            external_calls=INSTANCE_EXTERNAL_CALLS,
+            fetched=len(result.messages),
+        )
+
+    return run
+
+
+# ---------------------------------------------------------------------------
+# E 类：告警
+# ---------------------------------------------------------------------------
+
+def _alarm_executor(
+    client: Any,
+    mapping: Any,
+    config: Any,
+    watermark: Any,
+    clock: Callable[[], int],
+) -> Callable[[InstanceTarget], TaskOutcome]:
+    """E 类：告警 → **告警消息**（进 ``outcome.alarms``，不进 ``messages``）。"""
+
+    def run(target: InstanceTarget) -> TaskOutcome:
+        stream = alarm_stream(target.instance_id)
+        cursor = watermark.alarm_watermark(stream) if watermark is not None else None
+        result = collect_alarms(
+            client, mapping, target.nodes, target.instance_id, cursor,
+            int(clock()),
+            int(getattr(config, 'alarm_retention_days', 30)),
+            int(getattr(config, 'alarm_limit', 100)),
+        )
+        return TaskOutcome(
+            alarms=result.messages,
+            # 告警走自己的水位（``alarm_stream``），不推指标水位。
+            end_time_ms=None,
+            external_calls=ALARM_EXTERNAL_CALLS,
+            fetched=result.convergence_count + result.detail_count,
+        )
+
+    return run
diff --git a/tpops_kafka_collector/lifecycle.py b/tpops_kafka_collector/lifecycle.py
new file mode 100644
index 0000000..55fabab
--- /dev/null
+++ b/tpops_kafka_collector/lifecycle.py
@@ -0,0 +1,189 @@
+"""主循环与**优雅退出**（任务 3.3）。
+
+从 :mod:`tpops_kafka_collector.main` 里拆出来 —— 入口装配与「怎么跑、
+怎么退」是两件事，拆开后两个文件都在合同「单文件 < 400 行」之内。
+
+两条不可让渡的口径：
+
+1. **不用 ``scheduler.run()`` / ``run_forever()``** ——
+   它们内部 ``future.result()`` 没有超时，且线程池的上下文管理器会
+   ``shutdown(wait=True)``：只要有一个在途 HTTP 调用挂住，进程就永远不返回，
+   违反规格「放弃等待该请求 …… 不挂死」。
+   本模块自己跑主循环，每轮放在**守护线程**里跑并带截止时间。
+2. **停机后不再发起新的 HTTP 请求** —— 调度器只保证「不再发起新任务」，
+   **不保证**「不再发起新的 HTTP 请求」（本轮已排进线程池但还没开始跑的
+   任务仍会启动）→ 停机检查落在执行器那一层
+   （见 :mod:`tpops_kafka_collector.executors`）。
+
+优雅退出的顺序（规格「优雅退出」）::
+
+    收到 SIGTERM / SIGINT
+      → 置位 shutdown（执行器不再发起新的 HTTP 请求）
+      → 停发新任务；在途请求最多等 30 秒（**超时就放弃，不挂死**）
+      → 原子写水位
+      → flush / 关闭 Kafka producer
+      → 退出码 0
+"""
+import logging
+import threading
+import time
+from typing import Any, Callable, Optional
+
+from .scheduler import Scheduler
+from .scheduler_signals import install_signal_handlers, restore_signal_handlers
+from .scheduler_types import TickResult
+
+LOGGER = logging.getLogger(__name__)
+
+__all__ = [
+    'POLL_INTERVAL_SECONDS',
+    'SCHEDULER_STALE_SECONDS',
+    'SHUTDOWN_DEADLINE_SECONDS',
+    'TrackedScheduler',
+    'run',
+    'run_loop',
+    'shutdown_runtime',
+]
+
+#: 收到停机信号后，**最多**再等在途请求多少秒（超时就放弃等待）。
+SHUTDOWN_DEADLINE_SECONDS = 30
+
+#: 就绪探针的「最近一次成功采集」上限（秒）—— 超过就算不就绪。
+SCHEDULER_STALE_SECONDS = 180
+
+#: 主循环里等在途任务时的轮询间隔（秒）—— 置位后立刻醒来。
+POLL_INTERVAL_SECONDS = 0.1
+
+#: 正常退出码。
+EXIT_OK = 0
+
+
+class TrackedScheduler(Scheduler):
+    """记「最近一次成功 tick 时刻」的调度器。
+
+    ``/readyz`` 的 ``scheduler`` 探针要读这个时刻（**轻量**：读一个属性，
+    不发网络请求）。规格：最近 3 分钟内至少成功完成 1 轮 → 就绪。
+    """
+
+    def __init__(self, *args: Any, wall_clock: Any = None, **kwargs: Any) -> None:
+        super().__init__(*args, **kwargs)
+        self._wall_clock = wall_clock if wall_clock is not None else time.time
+        self._last_tick_ok_at = None  # type: Optional[float]
+
+    def tick(self) -> TickResult:
+        result = super().tick()
+        if result.tasks_failed == 0:
+            self._last_tick_ok_at = self._wall_clock()
+        return result
+
+    @property
+    def last_tick_ok_at(self) -> Optional[float]:
+        """最近一次**成功**完成的 tick 时刻（epoch 秒）；没有则 ``None``。"""
+        return self._last_tick_ok_at
+
+
+def run_loop(
+    runtime: Any,
+    shutdown: threading.Event,
+    deadline_seconds: float = SHUTDOWN_DEADLINE_SECONDS,
+    monotonic: Optional[Callable[[], float]] = None,
+) -> None:
+    """主循环：每轮跑一次 tick；收到停机信号后最多再等 ``deadline_seconds``。"""
+    clock = monotonic if monotonic is not None else time.monotonic
+    while not shutdown.is_set():
+        _run_one_tick(runtime.scheduler, shutdown, deadline_seconds, clock)
+        if shutdown.is_set():
+            break
+        shutdown.wait(runtime.config.poll_interval_seconds)
+
+
+def _run_one_tick(
+    scheduler: Any,
+    shutdown: threading.Event,
+    deadline_seconds: float,
+    monotonic: Callable[[], float],
+) -> bool:
+    """跑一轮（**带截止时间**）；超时放弃等待 → 返回 ``False``。
+
+    本轮放在**守护线程**里跑 —— 放弃等待后进程仍能退出（守护线程不拦解释器退出）。
+    """
+    worker = threading.Thread(
+        target=_tick_safely, args=(scheduler,), name='scheduler-tick', daemon=True,
+    )
+    worker.start()
+    if _wait_for_tick(worker, shutdown, deadline_seconds, monotonic):
+        return True
+    LOGGER.warning(
+        '在途请求超过 %d 秒仍未结束 —— 放弃等待本轮结果'
+        '（未投出的消息水位不推进，下轮重投）',
+        deadline_seconds,
+    )
+    return False
+
+
+def _tick_safely(scheduler: Any) -> None:
+    """跑一轮并兜住异常（进程不退出，下轮重试）。"""
+    try:
+        scheduler.tick()
+    except Exception:  # noqa: B902 —— 一轮失败不该带走进程
+        LOGGER.exception('本轮调度异常 —— 进程继续运行，下轮重试')
+
+
+def _wait_for_tick(
+    worker: threading.Thread,
+    shutdown: threading.Event,
+    deadline_seconds: float,
+    monotonic: Callable[[], float],
+) -> bool:
+    """等本轮结束；收到停机信号后最多再等 ``deadline_seconds`` 秒。
+
+    :returns: 本轮是否正常结束（``False`` = 超时放弃等待）。
+    """
+    shutdown_at = None  # type: Optional[float]
+    while worker.is_alive():
+        if shutdown_at is None and shutdown.is_set():
+            shutdown_at = monotonic()
+        if shutdown_at is None:
+            worker.join(timeout=POLL_INTERVAL_SECONDS)
+            continue
+        remaining = deadline_seconds - (monotonic() - shutdown_at)
+        if remaining <= 0:
+            return False
+        worker.join(timeout=min(POLL_INTERVAL_SECONDS, remaining))
+    return True
+
+
+def shutdown_runtime(runtime: Any) -> None:
+    """退出前的收尾：原子写水位 → flush / 关闭 producer → 停健康端点。"""
+    _safe(runtime.watermark.save, '水位落盘失败 —— 退出前未能写完水位')
+    _safe(runtime.producer.close, '关闭 Kafka 生产者失败')
+    if runtime.health is not None:
+        _safe(runtime.health.stop, '停止健康端点失败')
+
+
+def _safe(action: Callable[[], Any], message: str) -> None:
+    """执行一个收尾动作；失败只记日志（带堆栈），不影响退出码。"""
+    try:
+        action()
+    except Exception:  # noqa: B902 —— 收尾失败不该改变退出码
+        LOGGER.exception(message)
+
+
+def run(
+    runtime: Any,
+    shutdown: Optional[threading.Event] = None,
+    deadline_seconds: float = SHUTDOWN_DEADLINE_SECONDS,
+    monotonic: Optional[Callable[[], float]] = None,
+) -> int:
+    """跑主循环，收到停机信号后优雅退出；返回**退出码**（正常退出 0）。"""
+    stop = shutdown if shutdown is not None else getattr(runtime, 'shutdown', None)
+    if stop is None:  # pragma: no cover —— 兜底
+        stop = threading.Event()
+    previous = install_signal_handlers(stop)
+    try:
+        run_loop(runtime, stop, deadline_seconds=deadline_seconds, monotonic=monotonic)
+    finally:
+        restore_signal_handlers(previous)
+        shutdown_runtime(runtime)
+    LOGGER.info('采集端已优雅退出（退出码 %d）', EXIT_OK)
+    return EXIT_OK
