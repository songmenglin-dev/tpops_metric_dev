      },
      "remark": "",
      "cmd_content": "SELECT r.node_name,a.datname, a.usename,a.unique_sql_id, max(extract(epoch from current_timestamp-query_start)) AS max_query_runtime, count(1) AS query_count,sum(r.count) AS stream_thread_count, substring(a.query,0,50) AS query_str FROM ( SELECT query_id,node_name,remote_name,count(*), ROW_NUMBER() OVER (PARTITION BY query_id,node_name ORDER BY count DESC) as rn FROM pgxc_comm_send_stream GROUP BY query_id,node_name, remote_name  ) r LEFT JOIN pgxc_stat_activity a ON r.query_id = a.query_id WHERE r.rn = 1 AND a.pid <> pg_backend_pid() AND unique_sql_id IS NOT NULL GROUP BY 1,2,3,4,8 ORDER BY 1 ASC,7 DESC LIMIT 20;"
