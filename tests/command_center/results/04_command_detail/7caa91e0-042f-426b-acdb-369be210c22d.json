      "remark": "",
      "cmd_content": "SELECT a.pid , a.sessionid ,(now() - a.query_start) as query_runtime,(now() - a.xact_start) as xact_runtime, p.wait_status ,p.wait_event ,p.locktag, p.lockmode ,p.block_sessionid ,substr(a.query, 1, 50) as query FROM pg_stat_activity a ,pg_thread_wait_status p WHERE a.sessionid = p.sessionid AND a.pid <> pg_backend_pid() AND a.state != 'idle' AND a.waiting = true AND a.datname != 'postgres' AND a.usename != 'rdsAdmin' ORDER BY query_runtime DESC LIMIT 10;"
