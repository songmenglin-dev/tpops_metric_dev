      "remark": "检查om_agent进程路径",
      "cmd_content": "import subprocess\nimport re\nimport os\nimport pwd\ndef check_om_agent_path():\n    try:\n        current_user = pwd.getpwuid(os.getuid()).pw_name\n        if current_user != 'Ruby':\n            cmd = \"sudo -u Ruby -H bash -c \\\"ps ux | grep om_agent | grep -v grep | awk '{print \\$12}' | sed 's/\\/[^\\/]*$//' | uniq\\\"\"\n        else:\n            cmd = \"ps ux | grep om_agent | grep -v grep | awk '{print $12}' | sed 's/\\/[^\\/]*$//' | uniq\"\n        result = subprocess.run(\n            cmd,\n            shell=True,\n            capture_output=True,\n            text=True,\n            check=True\n        )\n        output = result.stdout.strip()\n        pattern = r'^/dbs/om-agent/agent_[^/]*$'\n        if re.match(pattern, output):\n            return True\n        else:\n            return False\n    except subprocess.CalledProcessError:\n        return False\n    except Exception:\n        return False\nif __name__ == \"__main__\":\n    print(check_om_agent_path(), end=\"\")"
    }
