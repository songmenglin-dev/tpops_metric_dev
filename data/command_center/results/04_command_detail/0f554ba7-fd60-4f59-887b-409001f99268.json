      "remark": null,
      "cmd_content": "select DISTINCT sessionid, cn_id, query_id, unique_query_id, unique_query, thread_id, xact_start_time, query_start_time, sample_time, timestamp_diff('second', xact_start_time, sample_time) AS runtime, state, (select username from pg_catalog.db_users pgu where pgu.user_id = gs.userid) as user_name,(select pgdb.datname from pg_catalog.pg_database pgdb where pgdb.oid= gs.databaseid) as database_name, application_name, block_sessionid, event, wait_status, client_hostname, client_addr, client_port from gs_asp gs where runtime > {threshold_seconds} AND sample_time between to_timestamp({start_time_stamp}/1000) and to_timestamp({end_time_stamp}/1000) AND gs.query_id <> 0 AND user_name NOT IN ('rdsAdmin', 'rdsMetric', 'rdsBackup', 'rdsRepl', 'dbmind_monitor_agent', 'dbmind_monitor') ORDER by runtime desc limit 100;"
