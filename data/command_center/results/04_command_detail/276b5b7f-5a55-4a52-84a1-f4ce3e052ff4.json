        "format": "json",
        "mode": "array",
        "type": "map",
        "is_redirect": false,
        "storage_mode": null,
        "save_dir": null
      },
      "compare_config": {
        "fields": [],
        "is_support": false
      },
      "remark": "",
      "cmd_content": "SELECT pgxc_node_str() AS node_name, (select setting from pg_settings where name = 'comm_max_stream') AS current_value, LEAST( ({cpu_nums} / {dn_nums})^2 * 2 * 20, ((SELECT setting::FLOAT FROM pg_settings WHERE name = 'max_process_memory') * 1024) * 0.005 / ((SELECT setting::FLOAT FROM pg_settings WHERE name = 'max_coordinators') + (SELECT setting::FLOAT FROM pg_settings WHERE name = 'comm_max_datanode')) / 380.0, 8192 ) AS calculated_value, GREATEST( FLOOR(calculated_value / 1024) * 1024, 1024) AS recommended_value LIMIT 5;"
    }
  }
