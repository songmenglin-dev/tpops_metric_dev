      "cmd_id": "276b5b7f-5a55-4a52-84a1-f4ce3e052ff4",
      "cmd_name": "DBS.stream_recommended_value",
      "cmd_type": "SQL",
      "description": "获取comm_max_stream参数推荐值。current_value为DN实际comm_max_stream值。recommended_value为根据当前环境规格计算出的DNcomm_max_stream参数的最大推荐值，取小于通过公式计算出的具体值calculated_value的1024的整数倍。",
      "call_type": "sync",
      "category": "error_scenes",
      "source": "default",
      "action": "query",
      "status": "enabled",
      "limit_usage": [
        "api"
      ],
      "creator": "admin",
      "operator": "admin",
      "create_time": 1793689875551,
      "operate_time": 1793689875551,
      "constraint_config": {
        "cluster_mode": "Distributed",
        "limit_node_types": [
          "master"
        ],
        "limit_component_types": [
          "dn:primary"
        ],
        "db_version": {
          "min_value": "",
          "max_value": null
        },
        "kernel_version": {
          "min_value": "",
          "max_value": null
        }
      },
      "param_config": {
        "params": [
          {
            "param_id": "03a9d371-8f2c-49c5-aced-f927791e5d72",
            "param_name": "dn_nums",
            "param_type": "single",
            "data_type": "integer",
            "sensitive": false,
            "required": true,
            "default_value": null,
            "min_value": "1",
            "max_value": "1000",
            "max_size": null,
            "enum_values": null,
            "pattern": "^[-]?\\\\d{1,10}$",
            "placeholder_wrapper": "origine",
            "description": "单个节点上的dn进程数"
          },
          {
            "param_id": "bf7bc3fc-74c6-497d-b374-6446d9ec9366",
            "param_name": "cpu_nums",
            "param_type": "single",
            "data_type": "integer",
            "sensitive": false,
            "required": false,
            "default_value": null,
            "min_value": "1",
            "max_value": "1000",
            "max_size": null,
            "enum_values": null,
            "pattern": "^[-]?\\\\d{1,10}$",
            "placeholder_wrapper": "origine",
            "description": "节点的cpu核数"
          }
        ]
      },
      "exec_config": {
        "params": [
          {
            "param_name": "switch_database",
            "param_value": false,
            "sensitive": null
          },
          {
            "param_name": "database_field",
            "param_value": null,
