      "remark": null,
      "cmd_content": "select logical_share_mem,logical_session_mem,process_mem,((logical_share_mem+logical_session_mem)*100/process_mem) as logical_mem_rate from (select sum(totalsize)/1024/1024 as logical_share_mem from gs_shared_memory_detail where contextname in('ParallelReorderBufferByXid','ParallelDecodeDispatcher','ParallelDecodeLog')) a,(select sum(totalsize)/1024/1024 as logical_session_mem from gs_session_memory_detail where contextname in('Read Worker','Replication command context')) b,(select memorymbytes as process_mem from gs_total_memory_detail where memorytype='max_process_memory') where 1=1;"
