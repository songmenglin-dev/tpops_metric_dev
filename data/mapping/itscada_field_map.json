{
  "version": "1.3",
  "note": "客户 Kafka 消息的字段清单。各字段的来源与转换规则按分类拆在同目录：metric_mapping_*.json（指标四类）、alarm_mapping.json（告警）",
  "source_documents": {
    "metric": "docs/ITSCADA第三方指标数据接入对接方案V2.docx",
    "alarm": "docs/ITSCADA第三方告警数据接入对接方案V2.docx"
  },
  "metric_message": {
    "doc_ref": "指标方案 §6.2",
    "fields": [
      {
        "name": "metricName",
        "type": "String",
        "required": true
      },
      {
        "name": "metricCode",
        "type": "String",
        "required": true
      },
      {
        "name": "resourceName",
        "type": "String",
        "required": true
      },
      {
        "name": "value",
        "type": "String",
        "required": true
      },
      {
        "name": "unit",
        "type": "String",
        "required": false
      },
      {
        "name": "clock",
        "type": "Long",
        "required": true
      },
      {
        "name": "tags",
        "type": "JSON",
        "required": false
      }
    ],
    "required_fields": [
      "metricName",
      "metricCode",
      "resourceName",
      "value",
      "clock"
    ]
  },
  "alarm_message": {
    "doc_ref": "告警方案 §3.2",
    "fields": [
      {
        "name": "alarmId",
        "type": "String",
        "required": true
      },
      {
        "name": "alarmName",
        "type": "String",
        "required": false
      },
      {
        "name": "alarmContent",
        "type": "String",
        "required": true
      },
      {
        "name": "priority",
        "type": "Integer",
        "required": true
      },
      {
        "name": "alarmTime",
        "type": "Long",
        "required": true
      },
      {
        "name": "status",
        "type": "Integer",
        "required": true
      },
      {
        "name": "recoverTime",
        "type": "Long",
        "required": "conditional"
      },
      {
        "name": "resourceName",
        "type": "String",
        "required": true
      },
      {
        "name": "metricName",
        "type": "String",
        "required": true
      },
      {
        "name": "metricCode",
        "type": "String",
        "required": true
      },
      {
        "name": "value",
        "type": "String",
        "required": true
      },
      {
        "name": "unit",
        "type": "String",
        "required": false
      },
      {
        "name": "tags",
        "type": "Object",
        "required": false
      }
    ],
    "required_fields": [
      "alarmId",
      "alarmContent",
      "priority",
      "alarmTime",
      "status",
      "resourceName",
      "metricName",
      "metricCode",
      "value"
    ]
  },
  "resource_name": {
    "template": "{host_ip}_{node_id}",
    "fallback_template": ["{host_ip}", "{node_id}"],
    "note": "resourceName 只能表示一个节点 → 固定「节点 IP + 节点 ID」（如 172.16.103.126_3881c04403394ee1b36a2bf873e69007no14），指标与告警同规则。节点身份来自 key-view-execute-node 的节点清单；与节点无关的指标（命令中心的实例级/表级/库级、诊断优化、实例接口）统一挂到节点清单里的第一个 master CN 上（role=master 且 type=CN），保证跨轮稳定。表名/库名/端口这类业务维度不再进资源名，改由 metricName/metricCode 的占位符与 tags.dimension_values 承载。具体命名规则要与客户 ITSCADA 台账录入的资源名称完全一致（open_items.json / resource-name，待客户提供台账清单后核对）。"
  },
  "tags": {
    "metric": [
      "instance_id",
      "instance_name",
      "node_id",
      "component_id",
      "host_ip",
      "dimension_values"
    ],
    "alarm": [
      "instance_id",
      "instance_name",
      "node_id",
      "host_ip",
      "alarm_category",
      "alarm_type",
      "engine",
      "alarm_duration",
      "details"
    ]
  }
}
