          "<node_id>"
        ],
        "params": [
          {
            "param_name": "sql_text",
            "param_value": "select schemaname, relname, n_live_tup, n_dead_tup, case when (n_live_tup + n_dead_tup) > 0 then round(n_dead_tup * 100.0 / (n_live_tup + n_dead_tup), 2) else 0 end as dead_tup_ratio from pg_stat_user_tables order by dead_tup_ratio desc"
          },
          {
            "param_name": "limit",
            "param_value": "100"
          }
        ]
      }
    },
    "expected_result": "每表一行：模式名、表名、活跃/死亡行数与死亡占比",
