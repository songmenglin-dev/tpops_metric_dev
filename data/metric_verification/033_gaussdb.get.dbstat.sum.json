        "params": [
          {
            "param_name": "sql_text",
            "param_value": "select d.datname, d.numbackends, d.xact_commit, d.xact_rollback, d.blks_read, d.blks_hit, t.schemaname, t.relname, t.n_live_tup, t.n_dead_tup, t.seq_scan, t.idx_scan, t.n_tup_ins, t.n_tup_upd, t.n_tup_del from pg_stat_database d left join pg_stat_user_tables t on d.datname = current_database() order by t.n_dead_tup desc limit 100"
