# TPOPS platform credentials -- copy to .env and fill in, .env is gitignored.
# Load with: set -a && source .env && set +a
#
# 本文件是**全部 30 个**配置项的示例（与 tpops_kafka_collector/config.py 一一对应）。
# 留空的值必须由使用者填写；默认值与 config.py 的默认值保持一致。
# 凭据只走环境变量 —— 不要把口令写进本文件、代码、日志或工单。

# ---------------------------------------------------------------------------
# TPOPS 平台
# ---------------------------------------------------------------------------

# TPOPS 平台登录用户名（mini-token 认证用），必填
TPOPS_USER=sml
# TPOPS 平台登录密码，必填。留空由使用者自行填写，切勿提交到仓库。
# 留空时启动即报「缺少必填环境变量：TPOPS_PASSWORD」并以退出码 2 退出。
TPOPS_PASSWORD=
# TPOPS 平台地址（含端口），默认 https://172.16.103.193:8002
# 改错的后果：连不上平台，所有通道全部失败，日志报连接错误
TPOPS_BASE_URL=https://172.16.103.193:8002
# 是否校验平台证书（true/false/1/0/yes/no/on/off），默认 false
# 平台使用自签证书 —— 置 true 会导致 TLS 握手失败、全部请求报错
TPOPS_VERIFY_TLS=false
# 单个 TPOPS HTTP 请求的超时（秒），默认 60，取值 ≥ 1
# 改得过小：慢响应被当成超时，命令中心频繁重试
# 改得过大：平台卡死时进程长时间挂住（退出时最多等 30 秒就放弃）
TPOPS_REQUEST_TIMEOUT=60
# 认证失败后的静默期（秒），默认 60，取值 ≥ 0；0 = 关闭
# 平台的认证失败会累计 login_failed_attempts 并锁号，
# 没有静默期等于每轮轮询都试一次 —— 慢性锁号。
# 改得过小：仍可能撞上锁号；改得过大：改完密码后要等很久才恢复
TPOPS_AUTH_FAILURE_COOLDOWN_SECONDS=60

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------

# Kafka 地址，多个用英文逗号分隔；PLAINTEXT 协议，必填
# 留空时启动即报「缺少必填环境变量：KAFKA_BOOTSTRAP_SERVERS」并以退出码 2 退出。
KAFKA_BOOTSTRAP_SERVERS=
# 监控指标投递的 Topic 名，默认 gaussdb.metrics（待客户最终确认）
# 改错的后果：消息投到客户没订阅的 Topic，客户侧看不到数据
KAFKA_TOPIC_METRICS=gaussdb.metrics
# 告警投递的 Topic 名，默认 gaussdb.alarms（待客户最终确认）
# 改错的后果：同上，告警侧客户收不到
KAFKA_TOPIC_ALARMS=gaussdb.alarms
# Topic 的分区数，默认 4，取值 ≥ 1
# 改错的后果：与客户预建的 Topic 分区数不一致时，生产者报「Topic 已存在但分区数不符」
KAFKA_TOPIC_PARTITIONS=4
# 压缩算法，默认 gzip；只允许 none / gzip
# （lz4 / snappy / zstd 需要额外装带 C 扩展的 Python 包，
#   两种架构的 wheel 不同，且目标机通常没装 —— 装了会在启动时报
#   "Libraries for lz4 compression codec not found"）
# 改错的后果：取值不在允许集合内 → 启动即失败（退出码 2）
KAFKA_COMPRESSION=gzip

# ---------------------------------------------------------------------------
# 调度与指标窗口
# ---------------------------------------------------------------------------

# 调度轮询间隔（秒），默认 30，取值 ≥ 1
# 改错的后果：调大则各通道的实际刷新周期被拉长（周期 = 轮询间隔）；
# 调得过小（< 10）则平台压力大，且命令中心一轮 3~8 秒的往返会频繁重叠
POLL_INTERVAL_SECONDS=30
# 指标查询窗口（小时），默认 2，取值 ≥ 1
# 改错的后果：改小于 1 会覆盖不到 3600s 采集周期的指标 → 对应指标大面积 null
METRIC_WINDOW_HOURS=2
# 指标查询 end_time 的回退量（分钟），默认 5，取值 ≥ 0
# 平台数据入库滞后约 5 分钟，不回退会导致尾部大量 null；回退过大则数据偏旧
METRIC_END_LAG_MINUTES=5

# ---------------------------------------------------------------------------
# 命令中心（统一命令中心 SQL 通道）
# ---------------------------------------------------------------------------

# 并发下发的命令条数，默认 2，取值 1~10
# 改错的后果：调大会给平台加压（实测并发 10 条时轮询超时率升高），
# 触发限流则整轮失败并重试；超过 10 启动即失败
CMD_CONCURRENCY=2
# 单次命令的 limit 行数，默认 1000，取值 1~1000（平台硬上限）
# 改错的后果：改小于实际行数会静默截断结果（部分指标少数据且不报错）
CMD_LIMIT=1000
# 合并 SQL 的分页容量（每页每个视图取多少行），默认 100，取值 1~1000
# 平台单次输出上限 102400 B，超了整条任务失败（不是截断）；
# 调大易触顶，调小则翻页次数变多
CMD_PAGE_SIZE=100
# 命令中心任务轮询的超时（秒），默认 60，取值 ≥ 1
# 单次往返实测 3~8 秒；改得过小会误判超时并触发重试
CMD_POLL_TIMEOUT=60
# 单条命令的失败重试次数，默认 3，取值 ≥ 0
# 实测 50 条 SQL 有 3 条偶发失败（重试即成功）；置 0 则偶发失败直接丢数据
CMD_RETRY_ATTEMPTS=3

# ---------------------------------------------------------------------------
# 告警
# ---------------------------------------------------------------------------

# 告警接口单页条数，默认 100，取值 1~100（平台硬上限）
# 改错的后果：超过 100 启动即失败；不翻页则告警可能漏拉（靠水位续传补）
ALARM_LIMIT=100
# 平台历史告警的保留天数，默认 30，取值 ≥ 1
# 平台只保留 30 天历史告警；停机超过这个天数，告警会永久丢失
# 该值用于判断「拉到的历史告警是否已超出平台保留期」并显式告警
ALARM_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# 慢 SQL 脱敏
# ---------------------------------------------------------------------------

# 是否对慢 SQL 文本脱敏，默认 true（true/false/1/0/yes/no/on/off）
# 关闭后 SQL 原文会外发到客户监控平台 —— 需客户书面确认后才能关
SQL_MASKING_ENABLED=true
# 慢 SQL 文本的最大长度（字符），默认 512，取值 ≥ 1；超出截断并显式标记
# 改得过大会让消息体膨胀；改得过小会让 SQL 失去排障价值
SQL_TEXT_MAX_LENGTH=512

# ---------------------------------------------------------------------------
# 通用重试
# ---------------------------------------------------------------------------

# 通用重试的最大尝试次数，默认 5，取值 ≥ 0
# 注：当前各调用点的重试次数由各自配置固定（命令中心用 CMD_RETRY_ATTEMPTS），
# 本项目前尚未被消费 —— 改动不影响当前运行行为
RETRY_MAX_ATTEMPTS=5
# 通用重试的退避基数（秒），默认 1.0，取值 ≥ 0
# 指数退避：1 → 2 → 4 → 8 …… ；命令中心 SQL 重试的退避基数取自这里
# 改得过大会拖慢失败恢复；过小则可能连续打在故障的平台上
RETRY_BASE_SECONDS=1.0

# ---------------------------------------------------------------------------
# 运行时（状态目录 / 健康端点 / 日志）
# ---------------------------------------------------------------------------

# 状态目录，默认 ./state（相对当前工作目录）
# 目录下的文件：watermark.json（水位 / 幂等键 / 差分基线）、
# platform_profile.json（平台画像，可手工编辑）
# 改错的后果：目录不可写 → 每轮落盘失败，重启后水位与去重状态全丢（数据整段重投）
STATE_DIR=./state
# 健康端点监听地址，默认 127.0.0.1（只监听回环）
# 改成 0.0.0.0 会把健康端点暴露到网络上
HEALTH_HOST=127.0.0.1
# 健康端点监听端口，默认 8088，取值 1~65535
# 端口被占用 → 装配失败，进程以退出码 3 退出
HEALTH_PORT=8088
# 日志级别，默认 INFO；允许 DEBUG / INFO / WARNING / ERROR / CRITICAL
# 改错的后果：取值不在允许集合内 → 启动即失败（退出码 2）；
# 置 DEBUG 会明显增大日志量
LOG_LEVEL=INFO
# 日志格式，默认 text；允许 text / json
# text 给人看（时间 | 级别 | 模块 | 消息），json 给日志平台按字段取
# 取值不在允许集合内 → 启动即失败（退出码 2）
LOG_FORMAT=text
