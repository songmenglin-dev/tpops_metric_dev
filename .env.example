# TPOPS platform credentials -- copy to .env and fill in, .env is gitignored.
# Load with: set -a && source .env && set +a

# TPOPS 平台登录用户名（mini-token 认证用）
TPOPS_USER=sml
# TPOPS 平台登录密码，留空由使用者自行填写，切勿提交到仓库
TPOPS_PASSWORD=
# TPOPS 平台地址（平台使用自签证书，客户端需 verify_tls=False）
TPOPS_BASE_URL=https://172.16.103.193:8002

# Kafka 地址，多个用英文逗号分隔；PLAINTEXT 协议，必填
KAFKA_BOOTSTRAP_SERVERS=
# 监控指标投递的 Topic 名，默认 gaussdb.metrics（待客户最终确认）
KAFKA_TOPIC_METRICS=gaussdb.metrics
# 告警投递的 Topic 名，默认 gaussdb.alarms（待客户最终确认）
KAFKA_TOPIC_ALARMS=gaussdb.alarms

# 调度轮询间隔（秒），默认 30
POLL_INTERVAL_SECONDS=30
# 指标查询窗口（小时），默认 2；不得小于 1，否则覆盖不到 3600s 采集周期的指标
METRIC_WINDOW_HOURS=2
# 指标查询 end_time 的回退量（分钟），默认 5；平台数据入库滞后约 5 分钟，不回退会导致尾部大量 null
METRIC_END_LAG_MINUTES=5
