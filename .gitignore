# --- credentials ---
.env
.env.*
!.env.example

# --- large binaries / vendor docs (too big for git) ---
*.chm
*.iso
*.dmg

# --- Office lock files (created when a doc is open in Office) ---
~$*

# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.venv/
venv/

# --- editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- regenerable metric exports ---
# All of these come from the TPOPS platform and are reproducible:
#   python tools/fetch_tpops_metrics.py --hours 2   # 原始抓取
#   python tools/build_tpops_metric_dict.py          # 由原始抓取重建指标字典
data/metrics_series_*.json
data/metrics_latest.json
data/metric_catalog.json
data/tpops_all_metric.json
data/metric_names.csv
data/manifest.json

# 原子写入的临时文件
*.tmp
.coverage
